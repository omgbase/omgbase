{
  "name": "@omgbase/client",
  "version": "0.0.0",
  "private": true,
  "description": "Open Markdown Graph Base — typed, browser-safe client, session and command layer over the minimal MCP surface (query, docs_read, docs_tree, blocks_resolve, changes_since, plan, execute, apply, version), with the shared Explorer commands: create a document, attach / detach a relation (additive frontmatter lists or body links), each one guarded apply with a compensating undo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omgbase/omgbase.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/omgbase/omgbase#readme",
  "bugs": {
    "url": "https://github.com/omgbase/omgbase/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-graph",
    "mcp",
    "model-context-protocol",
    "omgbase",
    "client",
    "browser",
    "undo"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./commands": {
      "import": "./dist/src/commands.js",
      "types": "./dist/src/commands.d.ts"
    },
    "./effects": {
      "import": "./dist/src/effects.js",
      "types": "./dist/src/effects.d.ts"
    },
    "./commands-documents": {
      "import": "./dist/src/commands-documents.js",
      "types": "./dist/src/commands-documents.d.ts"
    },
    "./commands-relations": {
      "import": "./dist/src/commands-relations.js",
      "types": "./dist/src/commands-relations.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
