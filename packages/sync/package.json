{
  "name": "@omgbase/sync",
  "version": "0.1.0",
  "description": "Open Markdown Graph Base — standalone store-to-store synchronizer: a coordinator over an EngineClient seam (in-process or MCP-client) and source adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omgbase/omgbase.git",
    "directory": "packages/sync"
  },
  "homepage": "https://github.com/omgbase/omgbase#readme",
  "bugs": {
    "url": "https://github.com/omgbase/omgbase/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-graph",
    "sqlite",
    "mcp",
    "model-context-protocol",
    "obsidian",
    "agents",
    "omgbase",
    "sync",
    "mirror",
    "coordinator"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/corpus/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "omgbase-sync": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@omgbase/core": "workspace:^",
    "@omgbase/fs-adapter": "workspace:^"
  }
}
