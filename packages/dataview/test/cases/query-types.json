  {
    "name": "table-with-columns",
    "dql": "TABLE file.mtime, due FROM \"projects\" WHERE due < date(today) SORT due DESC LIMIT 10",
    "oqx": "docs { select _path, _updated_at, due where (_path.startsWith(\"/projects/\") or _path == \"/projects.md\") and date(due) < date(\"today\") order by due desc limit 10 }",
    "render": {
      "type": "table",
      "withoutId": false,
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "_path",
        "derive": "link"
      },
      "columns": [
        {
          "name": "file.mtime",
          "alias": "_updated_at"
        },
        {
          "name": "due",
          "alias": "due"
        }
      ]
    },
    "warnings": []
  },
