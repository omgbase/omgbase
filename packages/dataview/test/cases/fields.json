  {
    "name": "task-fields",
    "dql": "TASK WHERE text != \"\" & !checked & fullyCompleted & path = \"a.md\" & blockId",
    "oqx": "blocks { select _path, _id, _text, checked where _type == \"task\" and _text != \"\" and !checked and checked and _path == \"a.md\" and _id }",
    "render": {
      "type": "task",
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "_path",
        "derive": "link"
      },
      "rows": null,
      "task": {
        "id": "_id",
        "text": "_text",
        "checked": "checked",
        "path": "_path"
      }
    },
    "warnings": [
      "fullyCompleted reads the task's own checkbox; subtasks are not consulted"
    ]
  },
  {
