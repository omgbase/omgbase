  {
    "name": "task-fields",
    "dql": "TASK WHERE text != \"\" & !checked & fullyCompleted & path = \"a.md\" & blockId",
    "oqx": "select path, id, text, checked from blocks where type == \"task\" and text != \"\" and !checked and checked and path == \"a.md\" and id",
    "render": {
      "type": "task",
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "path",
        "derive": "link"
      },
      "rows": null,
      "task": {
        "id": "id",
        "text": "text",
        "checked": "checked",
        "path": "path"
      }
    },
    "warnings": [
      "fullyCompleted reads the task's own checkbox; subtasks are not consulted"
    ]
  },
  {
