  {
    "name": "file-relations",
    "dql": "TABLE file.inlinks, file.outlinks, file.tasks, file.lists FROM \"x\"",
    "oqx": "select path, c0: in_links collect { from doc }, c1: out_links collect { from dst }, c2: blocks collect { where type == \"task\" }, c3: blocks collect { where type == \"list_item\" } from docs where path.startsWith(\"/x/\") or path == \"/x.md\"",
    "render": {
      "type": "table",
      "withoutId": false,
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "path",
        "derive": "link"
      },
      "columns": [
        {
          "name": "file.inlinks",
          "alias": "c0"
        },
        {
          "name": "file.outlinks",
          "alias": "c1"
        },
        {
          "name": "file.tasks",
          "alias": "c2"
        },
        {
          "name": "file.lists",
          "alias": "c3"
        }
      ]
    },
    "warnings": []
  },
