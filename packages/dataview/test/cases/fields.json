[
  {
    "name": "file-attributes",
    "dql": "TABLE file.path, file.name, file.folder, file.link, file.ext, file.size, file.mtime, file.mday FROM \"x\"",
    "oqx": "select path, c0: path, c1: path, c2: path, c3: path, c4: path, c5: size(raw), updated_at, c7: updated_at.date() from docs where path.startsWith(\"/x/\") or path == \"/x.md\"",
    "render": {
      "type": "table",
      "withoutId": false,
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "path",
        "derive": "link"
      },
      "columns": [
        {
          "name": "file.path",
          "alias": "c0"
        },
        {
          "name": "file.name",
          "alias": "c1",
          "derive": "basename"
        },
        {
          "name": "file.folder",
          "alias": "c2",
          "derive": "dirname"
        },
        {
          "name": "file.link",
          "alias": "c3",
          "derive": "link"
        },
        {
          "name": "file.ext",
          "alias": "c4",
          "derive": "ext"
        },
        {
          "name": "file.size",
          "alias": "c5"
        },
        {
          "name": "file.mtime",
          "alias": "updated_at"
        },
        {
          "name": "file.mday",
          "alias": "c7"
        }
      ]
    },
    "warnings": [
      "file.size is size(raw) — a code-point count of the source, not a byte count"
    ]
  },
