    "oqx": "select path, id, text, checked from blocks where type == \"task\" and doc.updated_at > date(\"2026-01-01\") and doc.tags exists { where $it == \"work\" or $it.startsWith(\"work/\") } and path.endsWith(\"/Today.md\")",
    "render": {
      "type": "task",
      "grouped": false,
