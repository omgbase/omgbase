[
  {
    "name": "file-attributes",
    "dql": "TABLE file.path, file.name, file.folder, file.link, file.ext, file.size, file.mtime, file.mday FROM \"x\"",
    "oqx": "docs { select _path, c0: _path, c1: _path, c2: _path, c3: _path, c4: _path, c5: size(_raw), _updated_at, c7: _updated_at.date() where _path.startsWith(\"/x/\") or _path == \"/x.md\" }",
    "render": {
      "type": "table",
      "withoutId": false,
      "grouped": false,
      "id": {
        "name": "File",
        "alias": "_path",
        "derive": "link"
      },
      "columns": [
        {
          "name": "file.path",
          "alias": "c0"
        },
        {
          "name": "file.name",
          "alias": "c1",
          "derive": "basename"
        },
        {
          "name": "file.folder",
          "alias": "c2",
          "derive": "dirname"
        },
        {
          "name": "file.link",
          "alias": "c3",
          "derive": "link"
        },
        {
          "name": "file.ext",
          "alias": "c4",
          "derive": "ext"
        },
        {
          "name": "file.size",
          "alias": "c5"
        },
        {
          "name": "file.mtime",
          "alias": "_updated_at"
        },
        {
          "name": "file.mday",
          "alias": "c7"
        }
      ]
    },
    "warnings": [
      "file.size is size(_raw) — a code-point count of the source, not a byte count"
    ]
  },
