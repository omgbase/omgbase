{
  "name": "@omgbase/git-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Open Markdown Graph Base — the Git-backed history provider (modular-core Phase 6a): a checkpoint worker that builds commits in a bare repository under .omgbase/git from the engine's change feed, and a HistoryReader over it; attached by the CLI/MCP host through the core's provider registry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omgbase/omgbase.git",
    "directory": "packages/git-adapter"
  },
  "homepage": "https://github.com/omgbase/omgbase#readme",
  "bugs": {
    "url": "https://github.com/omgbase/omgbase/issues"
  },
  "keywords": ["markdown", "knowledge-graph", "omgbase", "git", "history"],
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/**/*.map", "!dist/**/*.tsbuildinfo"],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@omgbase/core": "workspace:^"
  }
}
