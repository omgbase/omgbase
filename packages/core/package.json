{
  "name": "@omgbase/core",
  "version": "0.1.0",
  "description": "Open Markdown Graph Base — embedded engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omgbase/omgbase.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/omgbase/omgbase#readme",
  "bugs": {
    "url": "https://github.com/omgbase/omgbase/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-graph",
    "sqlite",
    "mcp",
    "model-context-protocol",
    "obsidian",
    "agents",
    "omgbase",
    "engine",
    "oqx",
    "query",
    "embedded"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/corpus/**",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@omgbase/oqx": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "fast-check": "^4.9.0"
  }
}
