{
  "suite": "resurrection",
  "cases": [
    {
      "name": "pool-exact-hash",
      "notes": "Phase 6b: an unmatched new block whose (type, raw_hash) is in the pool takes the pool id (resurrected, 0.99, exact_hash); consumed_pool lists it.",
      "old": {
        "source": "existing content here\n"
      },
      "new": {
        "source": "existing content here\n\na resurrected paragraph from a prior checkpoint\n"
      },
      "pool": [
        {
          "id": "b_old",
          "type": "paragraph",
          "raw": "a resurrected paragraph from a prior checkpoint"
        }
      ],
      "expect": {
        "assignment": {
          "/0": "b_0",
          "/1": "b_old"
        },
        "dispositions": [
          {
            "block": "b_0",
            "kind": "same",
            "confidence": 1,
            "reason": "exact_hash",
            "detail": {}
          },
          {
            "block": "b_old",
            "kind": "resurrected",
            "confidence": 0.99,
            "reason": "exact_hash",
            "detail": {}
          }
        ],
        "deleted": [],
        "consumed_pool": [
          "b_old"
        ]
      }
    },
    {
