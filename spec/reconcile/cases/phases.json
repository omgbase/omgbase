    {
      "name": "unequal-hash-groups-pair-nothing-in-phase-1",
      "notes": "Two byte-identical old blocks vs one new: the (type, raw_hash) groups differ in size, so phases 1–2 pair nothing; phase 5 then carries the first as `edited` (never `same`) and the second is deleted.",
      "old": {
        "source": "this exact paragraph appears twice in the old document today\n\nthis exact paragraph appears twice in the old document today\n"
      },
      "new": {
        "source": "this exact paragraph appears twice in the old document today\n"
      },
      "expect": {
        "assignment": {
          "/0": "b_0"
        },
        "dispositions": [
          {
            "block": "b_0",
            "kind": "edited",
            "confidence": 0.75,
            "reason": "scored",
            "detail": {}
          },
          {
            "block": "b_1",
            "kind": "deleted",
            "confidence": null,
            "reason": "tombstone",
            "detail": {}
          }
        ],
        "deleted": [
          "b_1"
        ],
        "consumed_pool": []
      }
    },
