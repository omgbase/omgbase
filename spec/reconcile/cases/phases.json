    {
      "name": "insertion-pushes-siblings-to-moved",
      "notes": "Pinned §10: `moved` compares positional keys, so after an insertion every following sibling is `moved` even though its parent is the same block.",
      "old": {
        "source": "# H\n\nFirst paragraph.\n\nSecond paragraph.\n"
      },
      "new": {
        "source": "# H\n\nInserted paragraph.\n\nFirst paragraph.\n\nSecond paragraph.\n"
      },
      "expect": {
        "assignment": {
          "/0": "b_0",
          "/1": null,
          "/2": "b_1",
          "/3": "b_2"
        },
        "dispositions": [
