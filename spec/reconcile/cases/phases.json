            "block": "b_2",
            "kind": "moved",
            "confidence": 1,
            "reason": "exact_hash",
            "detail": {}
          },
          {
            "block": "new:/1",
            "kind": "inserted",
            "confidence": null,
            "reason": null,
            "detail": {}
          }
        ],
        "deleted": [],
        "consumed_pool": []
      }
