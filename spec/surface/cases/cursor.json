{
  "suite": "cursor",
  "cases": [
    {
      "name": "encode-query-keyset",
      "notes": "§1.4: base64url(JSON [path, id]).",
      "parts": [
        "/practitioners/maria-prophetissa.md",
        "d_4"
      ],
      "expect": {
        "cursor": "WyIvcHJhY3RpdGlvbmVycy9tYXJpYS1wcm9waGV0aXNzYS5tZCIsImRfNCJd"
      }
    },
    {
      "name": "encode-list-keyset",
      "notes": "docs_list / docs_tree: a one-part tuple.",
      "parts": [
        "/index.md"
      ],
      "expect": {
        "cursor": "WyIvaW5kZXgubWQiXQ"
      }
    },
    {
      "name": "encode-unicode-path",
      "parts": [
        "/notes/café — ☿.md",
        "d_0"
      ],
      "expect": {
        "cursor": "WyIvbm90ZXMvY2Fmw6kg4oCUIOKYvy5tZCIsImRfMCJd"
      }
    },
    {
      "name": "encode-empty-strings",
      "parts": [
        "",
        ""
      ],
      "expect": {
        "cursor": "WyIiLCIiXQ"
      }
    },
    {
      "name": "decode-query-keyset",
      "cursor": "WyIvcHJhY3RpdGlvbmVycy9tYXJpYS1wcm9waGV0aXNzYS5tZCIsImRfNCJd",
      "arity": 2,
      "expect": {
        "parts": [
          "/practitioners/maria-prophetissa.md",
          "d_4"
        ]
      }
    },
    {
      "name": "decode-list-keyset",
      "cursor": "WyIvaW5kZXgubWQiXQ",
      "arity": 1,
      "expect": {
        "parts": [
          "/index.md"
        ]
      }
    },
    {
      "name": "decode-unicode-path",
      "cursor": "WyIvbm90ZXMvY2Fmw6kg4oCUIOKYvy5tZCIsImRfMCJd",
      "arity": 2,
      "expect": {
        "parts": [
          "/notes/café — ☿.md",
          "d_0"
        ]
      }
    },
    {
      "name": "decode-wrong-arity",
      "notes": "a list cursor handed to query.",
      "cursor": "WyIvaW5kZXgubWQiXQ",
      "arity": 2,
      "expect": {
        "error": "filter_invalid"
      }
    },
    {
      "name": "decode-garbage",
      "cursor": "garbage",
      "expect": {
        "error": "filter_invalid"
      }
    },
    {
      "name": "decode-not-an-array",
      "cursor": "eyJwYXRoIjoiYS5tZCJ9",
      "expect": {
        "error": "filter_invalid"
      }
    },
    {
      "name": "decode-non-string-part",
      "cursor": "WyIvYS5tZCIsMV0",
      "expect": {
        "error": "filter_invalid"
      }
    },
    {
      "name": "decode-empty",
      "cursor": "",
      "expect": {
        "error": "filter_invalid"
      }
    },
    {
      "name": "decode-standard-base64-padding-tolerated",
      "notes": "base64url decoding accepts padding and standard alphabet characters; the parts are what count.",
      "cursor": "WyIvaW5kZXgubWQiXQ==",
      "arity": 1,
      "expect": {
        "parts": [
          "/index.md"
        ]
      }
    }
  ]
}
