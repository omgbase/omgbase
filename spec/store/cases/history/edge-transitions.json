      "name": "edge-kept-through-unrelated-edit",
      "notes": "§3.3: an edit elsewhere leaves the edge untouched (from_commit stays c_0, still open).",
      "steps": [
        {
          "observe": {
            "ts": "2026-09-26T10:00:00.000Z",
            "items": [
              {
                "path": "a.md",
                "source": "[a](/x.md)\n\nOther.\n"
              }
            ]
          }
        },
        {
          "observe": {
            "ts": "2026-09-26T10:01:00.000Z",
            "items": [
              {
                "path": "a.md",
                "source": "[a](/x.md)\n\nOther, edited.\n"
              }
            ]
          }
        }
      ],
      "expect": {
        "edge_transitions": [
          {
            "edge_id": "e_0",
            "src_doc": "d_0",
            "src_block": "b_0",
            "src_field": null,
            "predicate": "references",
            "dst_kind": "document",
            "dst_node": "phantom:x.md",
            "anchor": null,
            "provenance": "link",
            "via_node": null,
            "from_commit": "c_0",
            "to_commit": null
          }
        ]
      }
    },
