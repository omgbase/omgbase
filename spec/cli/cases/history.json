{
  "suite": "history",
  "cases": [
    {
      "name": "log",
      "notes": "§6: `#seq origin summary`, oldest first from the cursor",
      "workspace": "alchemy",
      "argv": [
        "log"
      ],
      "expect": {
        "exit": 0,
        "stdout": "#1 observed observed: index.md — 31 inserted\n#2 observed observed: lab/2026-01-notes.md — 28 inserted\n#3 observed observed: lab/2026-02-notes.md — 23 inserted\n#4 observed observed: practitioners/jabir-ibn-hayyan.md — 13 inserted\n#5 observed observed: practitioners/maria-prophetissa.md — 13 inserted\n#6 observed observed: practitioners/newton.md — 14 inserted\n#7 observed observed: practitioners/paracelsus.md — 16 inserted\n#8 observed observed: processes/calcination.md — 20 inserted\n#9 observed observed: processes/coagulation.md — 14 inserted\n#10 observed observed: processes/dissolution.md — 15 inserted\n#11 observed observed: processes/magnum-opus.md — 22 inserted\n#12 observed observed: substances/mercury.md — 17 inserted\n#13 observed observed: substances/philosophers-stone.md — 21 inserted\n#14 observed observed: substances/prima-materia.md — 14 inserted\n#15 observed observed: substances/salt.md — 20 inserted\n#16 observed observed: substances/sulphur.md — 8 inserted\n#17 observed observed: texts/emerald-tablet.md — 13 inserted\n#18 observed observed: texts/mutus-liber.md — 12 inserted\n"
      }
    },
    {
      "name": "log-limit-footer",
      "notes": "the truncation footer names the next cursor",
      "workspace": "alchemy",
      "argv": [
        "log",
        "-n",
        "2"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "#1 observed observed: index.md — 31 inserted\n#2 observed observed: lab/2026-01-notes.md — 28 inserted\n",
        "stderr": "… truncated; continue with --cursor 2\n"
      }
    },
    {
      "name": "log-ids",
      "notes": "§3.4: --ids prints the commit ids and the truncation footer, like every mode but --json",
      "workspace": "alchemy",
      "argv": [
        "log",
        "-n",
        "2",
        "--ids"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "c_0\nc_1\n",
        "stderr": "… truncated; continue with --cursor 2\n"
      }
    },
    {
      "name": "log-jsonl",
      "workspace": "alchemy",
      "argv": [
        "log",
        "-n",
        "1",
        "--jsonl"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "{\"commit\":\"c_0\",\"seq\":1,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"actor\":null,\"summary\":\"observed: index.md — 31 inserted\",\"revisions\":[{\"doc\":\"d_0\",\"path\":\"index.md\",\"contentHash\":\"74252946d208ad5c5e7f3b1a75d9e2feee6d8dfd06386fb09c47f23b797d0bed\"}]}\n",
        "stderr": "… truncated; continue with --cursor 1\n"
      }
    },
    {
      "name": "log-json",
      "workspace": "alchemy",
      "argv": [
        "log",
        "-n",
        "1",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"digests\":[{\"commit\":\"c_0\",\"seq\":1,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"actor\":null,\"summary\":\"observed: index.md — 31 inserted\",\"revisions\":[{\"doc\":\"d_0\",\"path\":\"index.md\",\"contentHash\":\"74252946d208ad5c5e7f3b1a75d9e2feee6d8dfd06386fb09c47f23b797d0bed\"}]}],\"cursor\":1,\"truncated\":true,\"head\":18}\n"
      }
    },
    {
      "name": "log-cursor",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--cursor",
        "17"
      ],
      "expect": {
        "exit": 0,
        "stdout": "#18 observed observed: texts/mutus-liber.md — 12 inserted\n"
      }
    },
    {
      "name": "log-cursor-json",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--cursor",
        "17",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"digests\":[{\"commit\":\"c_17\",\"seq\":18,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"actor\":null,\"summary\":\"observed: texts/mutus-liber.md — 12 inserted\",\"revisions\":[{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"contentHash\":\"ccd682da7c3f643751e4aee291b18b75995ef9f883ececc5f925031bb319f4b5\"}]}],\"cursor\":18,\"truncated\":false,\"head\":18}\n"
      }
    },
    {
      "name": "log-since-literal",
      "notes": "--since <ISO> → the commits after the last one before that instant",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--since",
        "2026-09-26T00:00:00Z",
        "-n",
        "1"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "#1 observed observed: index.md — 31 inserted\n",
        "stderr": "… truncated; continue with --cursor 1\n"
      }
    },
    {
      "name": "log-since-future",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--since",
        "2026-09-28T00:00:00Z"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "  no changes\n"
      }
    },
    {
      "name": "log-since-relative",
      "notes": "24h resolves against the (pinned) clock",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--since",
        "24h",
        "-n",
        "1"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "#1 observed observed: index.md — 31 inserted\n",
        "stderr": "… truncated; continue with --cursor 1\n"
      }
    },
    {
      "name": "log-since-garbage",
      "notes": "§6: an unparsable --since is a usage error (exit 2)",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--since",
        "garbage",
        "-n",
        "1"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "usage: bad --since 'garbage' (use a relative age like 24h or 7d, or an ISO timestamp)\n"
      }
    },
    {
      "name": "log-origin-api-empty",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--origin",
        "api"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "  no changes\n"
      }
    },
    {
      "name": "log-origin-observed-limit",
      "workspace": "alchemy",
      "argv": [
        "log",
        "--origin",
        "observed",
        "-n",
        "1",
        "--cursor",
        "16"
      ],
      "expect": {
        "exit": 0,
        "stdout": "#17 observed observed: texts/emerald-tablet.md — 13 inserted\n"
      }
    },
    {
      "name": "log-after-writes",
      "notes": "api commits carry the actor in the summary; --origin filters",
      "workspace": "alchemy",
      "steps": [
        {
          "argv": [
            "update",
            "b_309",
            "-m",
            "Draft, revised.",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_309\n",
            "stderr": "  updating b_309 (CAS pinned from current bytes)\n  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "done",
            "b_311",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_311\n",
            "stderr": "  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "log",
            "--cursor",
            "18"
          ],
          "expect": {
            "exit": 0,
            "stdout": "#19 api      api(human:spec): texts/mutus-liber.md — 12 edited\n#20 api      api(human:spec): texts/mutus-liber.md — 12 edited\n"
          }
        },
        {
          "argv": [
            "log",
            "--origin",
            "api",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"digests\":[{\"commit\":\"c_18\",\"seq\":19,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"api\",\"actor\":\"human:spec\",\"summary\":\"api(human:spec): texts/mutus-liber.md — 12 edited\",\"revisions\":[{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"contentHash\":\"ff981464d3f8e6ba3e8b031b2d0471498b9fd6fdb374ca8bdf639c8612a4268f\"}]},{\"commit\":\"c_19\",\"seq\":20,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"api\",\"actor\":\"human:spec\",\"summary\":\"api(human:spec): texts/mutus-liber.md — 12 edited\",\"revisions\":[{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"contentHash\":\"b37b7d543115d4630871628739402dba87cf6137a4029d213124045838358240\"}]}],\"cursor\":20,\"truncated\":false,\"head\":20}\n"
          }
        },
        {
          "argv": [
            "log",
            "--origin",
            "api",
            "--ids"
          ],
          "expect": {
            "exit": 0,
            "stdout": "c_18\nc_19\n"
          }
        },
        {
          "argv": [
            "log",
            "--since",
            "2026-09-27T00:00:00.000Z"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "#1 observed observed: index.md — 31 inserted\n#2 observed observed: lab/2026-01-notes.md — 28 inserted\n#3 observed observed: lab/2026-02-notes.md — 23 inserted\n#4 observed observed: practitioners/jabir-ibn-hayyan.md — 13 inserted\n#5 observed observed: practitioners/maria-prophetissa.md — 13 inserted\n#6 observed observed: practitioners/newton.md — 14 inserted\n#7 observed observed: practitioners/paracelsus.md — 16 inserted\n#8 observed observed: processes/calcination.md — 20 inserted\n#9 observed observed: processes/coagulation.md — 14 inserted\n#10 observed observed: processes/dissolution.md — 15 inserted\n#11 observed observed: processes/magnum-opus.md — 22 inserted\n#12 observed observed: substances/mercury.md — 17 inserted\n#13 observed observed: substances/philosophers-stone.md — 21 inserted\n#14 observed observed: substances/prima-materia.md — 14 inserted\n#15 observed observed: substances/salt.md — 20 inserted\n#16 observed observed: substances/sulphur.md — 8 inserted\n#17 observed observed: texts/emerald-tablet.md — 13 inserted\n#18 observed observed: texts/mutus-liber.md — 12 inserted\n#19 api      api(human:spec): texts/mutus-liber.md — 12 edited\n#20 api      api(human:spec): texts/mutus-liber.md — 12 edited\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "name": "hist",
      "notes": "§6: `#seq kind (confidence) origin ts`, newest first",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "b_303"
      ],
      "expect": {
        "exit": 0,
        "stdout": "#18 inserted observed 2026-09-27T00:00:00.000Z\n"
      }
    },
    {
      "name": "hist-json",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "b_303",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "[{\"commitId\":\"c_17\",\"seq\":18,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"kind\":\"inserted\",\"confidence\":null,\"reason\":null}]\n"
      }
    },
    {
      "name": "hist-jsonl",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "b_303",
        "--jsonl"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"commitId\":\"c_17\",\"seq\":18,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"kind\":\"inserted\",\"confidence\":null,\"reason\":null}\n"
      }
    },
    {
      "name": "hist-ids-is-human",
      "notes": "§3.2: a change carries no id, so --ids prints the --json document",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "b_303",
        "--ids"
      ],
      "expect": {
        "exit": 0,
        "stdout": "[{\"commitId\":\"c_17\",\"seq\":18,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"kind\":\"inserted\",\"confidence\":null,\"reason\":null}]\n"
      }
    },
    {
      "name": "hist-on-doc",
      "notes": "a document ref is block_missing",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "texts/mutus-liber.md"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[block_missing]: hist needs a block id; got texts/mutus-liber.md\n"
      }
    },
    {
      "name": "hist-missing",
      "workspace": "alchemy",
      "argv": [
        "hist",
        "b_9999"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[block_missing]: hist needs a block id; got b_9999\n"
      }
    },
    {
      "name": "hist-no-arg",
      "workspace": "alchemy",
      "argv": [
        "hist"
      ],
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "usage: hist requires a <node>\n"
      }
    },
    {
      "name": "hist-after-writes",
      "workspace": "alchemy",
      "steps": [
        {
          "argv": [
            "update",
            "b_309",
            "-m",
            "Draft, revised.",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_309\n",
            "stderr": "  updating b_309 (CAS pinned from current bytes)\n  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "update",
            "b_309",
            "-m",
            "Draft, revised twice.",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_309\n",
            "stderr": "  updating b_309 (CAS pinned from current bytes)\n  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "hist",
            "b_309"
          ],
          "expect": {
            "exit": 0,
            "stdout": "#20 edited (1.00) api 2026-09-27T00:00:00.000Z\n#19 edited (1.00) api 2026-09-27T00:00:00.000Z\n#18 inserted observed 2026-09-27T00:00:00.000Z\n"
          }
        },
        {
          "argv": [
            "hist",
            "b_309",
            "-n",
            "1"
          ],
          "expect": {
            "exit": 0,
            "stdout": "#20 edited (1.00) api 2026-09-27T00:00:00.000Z\n"
          }
        },
        {
          "argv": [
            "hist",
            "b_309",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "[{\"commitId\":\"c_19\",\"seq\":20,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"api\",\"kind\":\"edited\",\"confidence\":1,\"reason\":\"api\"},{\"commitId\":\"c_18\",\"seq\":19,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"api\",\"kind\":\"edited\",\"confidence\":1,\"reason\":\"api\"},{\"commitId\":\"c_17\",\"seq\":18,\"ts\":\"2026-09-27T00:00:00.000Z\",\"origin\":\"observed\",\"kind\":\"inserted\",\"confidence\":null,\"reason\":null}]\n"
          }
        },
        {
          "argv": [
            "show",
            "b_309",
            "--include",
            "history"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  [B] paragraph  b_309\n  ----------------------------------------\n  placement  parent=— ordinal=7 depth=0\n  text  Draft, revised twice.\n  history\n    #20 edited api 2026-09-27T00:00:00.000Z\n    #19 edited api 2026-09-27T00:00:00.000Z\n    #18 inserted observed 2026-09-27T00:00:00.000Z\n"
          }
        }
      ]
    },
    {
      "name": "diff-single-revision",
      "notes": "§6: one revision → previous == current → `no changes`",
      "workspace": "alchemy",
      "argv": [
        "diff",
        "texts/mutus-liber.md"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "  no changes\n"
      }
    },
    {
      "name": "diff-single-revision-json",
      "workspace": "alchemy",
      "argv": [
        "diff",
        "texts/mutus-liber.md",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"from\":\"r_17\",\"to\":\"r_17\",\"diff\":\"\"}\n"
      }
    },
    {
      "name": "diff-missing",
      "workspace": "alchemy",
      "argv": [
