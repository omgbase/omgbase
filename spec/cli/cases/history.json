        "stderr": "usage: diff requires a <doc>\n"
      }
    },
    {
      "name": "diff-after-writes",
      "notes": "default previous → current; --from/--to pick revisions; an unknown revision is target_missing; --jsonl prints the --json document (§3.2)",
      "workspace": "alchemy",
      "steps": [
        {
          "argv": [
            "update",
            "b_309",
            "-m",
            "Draft, revised.",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_309\n",
            "stderr": "  updating b_309 (CAS pinned from current bytes)\n  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "update",
            "b_309",
            "-m",
            "From the second write.",
            "--actor",
            "human:spec"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "b_309\n",
            "stderr": "  updating b_309 (CAS pinned from current bytes)\n  ok committed · 1 document touched\n"
          }
        },
        {
          "argv": [
            "diff",
            "texts/mutus-liber.md"
          ],
          "expect": {
            "exit": 0,
            "stdout": "@@ -27,7 +27,7 @@\n \n ## Status of these notes\n \n-Draft, revised.\n+From the second write.\n \n - [ ] Obtain a facsimile with plate numbering\n - [ ] Compare the 1677 and 1702 plate sequences\n"
          }
        },
        {
          "argv": [
            "diff",
            "texts/mutus-liber.md",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"from\":\"r_18\",\"to\":\"r_19\",\"diff\":\"@@ -27,7 +27,7 @@\\n \\n ## Status of these notes\\n \\n-Draft, revised.\\n+From the second write.\\n \\n - [ ] Obtain a facsimile with plate numbering\\n - [ ] Compare the 1677 and 1702 plate sequences\"}\n"
          }
        },
        {
          "argv": [
            "diff",
            "d_17",
            "--from",
            "r_17"
          ],
          "expect": {
            "exit": 0,
            "stdout": "@@ -27,8 +27,7 @@\n \n ## Status of these notes\n \n-Draft. I have not worked through the plates in order against a commentary, and\n-the secondary literature disagrees about even the number of stages depicted.\n+From the second write.\n \n - [ ] Obtain a facsimile with plate numbering\n - [ ] Compare the 1677 and 1702 plate sequences\n"
          }
        },
        {
          "argv": [
            "diff",
            "texts/mutus-liber.md",
            "--from",
            "r_17",
            "--to",
            "r_18"
          ],
          "expect": {
            "exit": 0,
            "stdout": "@@ -27,8 +27,7 @@\n \n ## Status of these notes\n \n-Draft. I have not worked through the plates in order against a commentary, and\n-the secondary literature disagrees about even the number of stages depicted.\n+Draft, revised.\n \n - [ ] Obtain a facsimile with plate numbering\n - [ ] Compare the 1677 and 1702 plate sequences\n"
          }
        },
        {
          "argv": [
            "diff",
            "texts/mutus-liber.md",
            "--to",
            "r_9999"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[target_missing]: no revision \"r_9999\" for document d_17\n  {\n    \"doc\": \"d_17\",\n    \"rev\": \"r_9999\"\n  }\n"
          }
        },
        {
          "argv": [
            "diff",
            "texts/mutus-liber.md",
            "--jsonl"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"doc\":\"d_17\",\"path\":\"texts/mutus-liber.md\",\"from\":\"r_18\",\"to\":\"r_19\",\"diff\":\"@@ -27,7 +27,7 @@\\n \\n ## Status of these notes\\n \\n-Draft, revised.\\n+From the second write.\\n \\n - [ ] Obtain a facsimile with plate numbering\\n - [ ] Compare the 1677 and 1702 plate sequences\"}\n"
          }
        }
      ]
    },
