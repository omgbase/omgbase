{
  "suite": "admin",
  "cases": [
    {
      "name": "init",
      "notes": "§6: creates .omgbase/; the git note and the next-step hint on stderr",
      "workspace": "none",
      "argv": [
        "init",
        "--yes",
        "--no-embedder"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "  omgbase  >  initialized\n  ----------------------------------------\n  ok workspace  <workspace>\n",
        "stderr": "  not inside a git repo — no .gitignore needed for .omgbase/\n  next: omg source add . to point a repo at a directory of files\n"
      }
    },
    {
      "name": "init-json",
      "workspace": "none",
      "argv": [
        "init",
        "--yes",
        "--no-embedder",
        "--json"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "{\"workspace\":\"<workspace>\"}\n",
        "stderr": "  not inside a git repo — no .gitignore needed for .omgbase/\n"
      }
    },
    {
      "name": "init-subdir",
      "workspace": "none",
      "steps": [
        {
          "argv": [
            "init",
            "sub",
            "--yes",
            "--no-embedder"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "  omgbase  >  initialized\n  ----------------------------------------\n  ok workspace  <workspace>/sub\n",
            "stderr": "  not inside a git repo — no .gitignore needed for .omgbase/\n  next: omg source add . to point a repo at a directory of files\n"
          }
        },
        {
          "argv": [
            "-C",
            "sub",
            "repos"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "argv": [
            "-C",
            "sub",
            "repos",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"repos\":[]}\n"
          }
        },
        {
          "argv": [
            "repos"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no omgbase workspace found at or above <workspace>\n  hint: run `omg init` to create one here, or `omg -C <dir> …` to run inside an existing workspace\n"
          }
        }
      ]
    },
    {
      "name": "init-twice",
      "workspace": "empty",
      "argv": [
        "init",
        "--yes",
        "--no-embedder"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[path_taken]: workspace already initialized at <workspace>\n"
      }
    },
    {
      "name": "init-embedder-verbatim",
      "notes": "--embedder sets the provider without a PATH check; `find` then fails embedder_failed",
      "workspace": "none",
      "steps": [
        {
          "argv": [
            "init",
            "--yes",
            "--embedder",
            "/nonexistent/embedder"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "  omgbase  >  initialized\n  ----------------------------------------\n  ok workspace  <workspace>\n",
            "stderr": "  not inside a git repo — no .gitignore needed for .omgbase/\n  embedding.provider = /nonexistent/embedder (workspace default)\n  next: omg source add . to point a repo at a directory of files\n"
          }
        },
        {
          "argv": [
            "config",
            "list",
            "--repo",
            ""
          ],
          "expect": {
            "exit": 0,
            "stdout": "  embedding = {\"provider\":\"/nonexistent/embedder\"}\n"
          }
        },
        {
          "argv": [
            "config",
            "get",
            "embedding.provider",
            "--repo",
            ""
          ],
          "expect": {
            "exit": 0,
            "stdout": "/nonexistent/embedder\n"
          }
        }
      ]
    },
    {
      "name": "init-unpinned-offers",
      "notes": "without --yes/--no-embedder the offers depend on the TTY and on PATH (unpinned); a non-TTY run skips both",
      "workspace": "none",
      "argv": [
        "init",
        "--no-embedder"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "  omgbase  >  initialized\n  ----------------------------------------\n  ok workspace  <workspace>\n",
        "stderr": "  not inside a git repo — no .gitignore needed for .omgbase/\n  next: omg source add . to point a repo at a directory of files\n"
      }
    },
    {
      "name": "empty-workspace-reads",
      "notes": "§2.1: a workspace with no repo — repo_not_found with no candidates",
      "workspace": "empty",
      "steps": [
        {
          "argv": [
            "repos"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "argv": [
            "status"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no repo contains <workspace>; select one with --repo\n  {\n    \"candidates\": []\n  }\n"
          }
        },
        {
          "argv": [
            "ls"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no repo contains <workspace>; select one with --repo\n  {\n    \"candidates\": []\n  }\n"
          }
        },
        {
          "argv": [
            "q",
            "from docs"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no repo contains <workspace>; select one with --repo\n  {\n    \"candidates\": []\n  }\n"
          }
        },
        {
          "argv": [
            "doctor"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no repo contains <workspace>; select one with --repo\n  {\n    \"candidates\": []\n  }\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "argv": [
            "source",
            "list",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "[]\n"
          }
        },
        {
          "argv": [
            "config"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "argv": [
            "config",
            "--repo",
            "",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "argv": [
            "embed"
          ],
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "error[repo_not_found]: no repo contains <workspace>; select one with --repo\n  {\n    \"candidates\": []\n  }\n"
          }
        }
      ]
    },
    {
      "name": "source-add",
      "notes": "§6: creates the repo (named after the directory), registers `<slug>-fs`, runs the initial sync",
      "workspace": "empty",
      "files": {
        "notes/a.md": "# A\n\nAlpha.\n",
        "notes/sub/b.md": "# B\n\nBeta [a](/a.md).\n"
      },
      "steps": [
        {
          "argv": [
            "source",
            "add",
            "notes",
            "-y"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "  * notes ← <workspace>/notes  2 files\n",
            "stderr": ""
          }
        },
        {
          "argv": [
            "repos"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  * notes  <workspace>/notes  2 docs  4 blocks\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  notes-fs  fs  <workspace>/notes  → notes\n"
          }
        },
        {
          "argv": [
            "source",
            "list",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "[{\"name\":\"notes-fs\",\"adapter\":\"fs\",\"config\":{\"root\":\"<workspace>/notes\"},\"repos\":[\"notes\"]}]\n"
          }
        },
        {
          "argv": [
            "ls"
          ],
          "expect": {
            "exit": 0,
            "stdout": "/a.md      2 blocks  0s ago\n/sub/b.md  2 blocks  0s ago\n"
          }
        },
        {
          "argv": [
            "log"
          ],
          "expect": {
            "exit": 0,
            "stdout": "#1 observed observed: /a.md — 2 inserted\n#2 observed observed: /sub/b.md — 2 inserted\n"
          }
        },
        {
          "argv": [
            "status",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"repoId\":\"rp_0\",\"slug\":\"notes\",\"rootPath\":\"<workspace>/notes\",\"docs\":2,\"blocks\":4,\"commits\":2,\"openEdges\":1,\"unconverged\":0,\"disk\":{\"changed\":0,\"deleted\":0,\"untracked\":0,\"checked\":true},\"sync\":{\"lastCommitSeq\":2,\"lastCheckpoint\":\"cp_0\",\"convergent\":true,\"diskChecked\":true,\"disk\":{\"changed\":0,\"deleted\":0,\"untracked\":0,\"checked\":true}},\"watcher\":\"none\",\"embedQueue\":0}\n"
          }
        },
        {
          "argv": [
            "-C",
            "notes/sub",
            "ls",
            "--ids"
          ],
          "expect": {
            "exit": 0,
            "stdout": "/a.md\n/sub/b.md\n"
          }
        }
      ]
    },
    {
      "name": "source-add-json",
      "workspace": "empty",
      "files": {
        "notes/a.md": "# A\n"
      },
      "argv": [
        "source",
        "add",
        "notes",
        "-y",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"repo\":\"notes\",\"repoId\":\"rp_0\",\"source\":\"notes-fs\",\"root\":\"<workspace>/notes\",\"ingested\":1}\n"
      }
    },
    {
      "name": "source-add-named",
      "workspace": "empty",
      "files": {
        "notes/a.md": "# A\n"
      },
      "steps": [
        {
          "argv": [
            "source",
            "add",
            "notes",
            "--repo",
            "r",
            "--name",
            "primary",
            "-y"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 0,
            "stdout": "  * r ← <workspace>/notes  1 files\n",
            "stderr": ""
          }
        },
        {
          "argv": [
            "source",
            "list",
            "--ids"
          ],
          "expect": {
            "exit": 0,
            "stdout": "primary\n"
          }
        },
        {
          "argv": [
            "repos",
            "--ids"
          ],
          "expect": {
            "exit": 0,
            "stdout": "r\n"
          }
        }
      ]
    },
    {
      "name": "source-add-refuses-without-yes",
      "notes": "§6: a non-TTY without -y is a usage error (exit 2, with a hint); nothing is created",
      "workspace": "empty",
      "files": {
        "notes/a.md": "# A\n"
      },
      "steps": [
        {
          "argv": [
            "source",
            "add",
            "notes"
          ],
          "pin_stderr": true,
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "usage: refusing without -y (would ingest files under <workspace>/notes)\n  hint: there is no TTY to confirm on; pass -y to consent to the ingest\n"
          }
        },
        {
          "argv": [
            "repos"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        }
      ]
    },
    {
      "name": "source-add-missing-dir",
      "workspace": "empty",
      "argv": [
        "source",
        "add",
        "nope",
        "-y"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[target_missing]: no such directory: <workspace>/nope\n"
      }
    },
    {
      "name": "source-add-no-dir",
      "workspace": "empty",
      "argv": [
        "source",
        "add"
      ],
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "usage: source add requires a <dir>\n"
      }
    },
    {
      "name": "source-add-duplicate-name",
      "workspace": "alchemy",
      "argv": [
        "source",
        "add",
        "vault",
        "--repo",
        "fixture",
        "-y"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[path_taken]: a source named 'fixture-fs' already exists\n"
      }
    },
    {
      "name": "source-add-second-source-same-repo",
      "notes": "a second source for an existing repo ingests what is new (nothing here)",
      "workspace": "alchemy",
      "steps": [
        {
          "argv": [
            "source",
            "add",
            "vault",
            "--repo",
            "fixture",
            "--name",
            "mirror",
            "-y",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"repo\":\"fixture\",\"repoId\":\"rp_0\",\"source\":\"mirror\",\"root\":\"<workspace>/vault\",\"ingested\":0}\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  fixture-fs  fs  <workspace>/vault  → fixture\n  mirror      fs  <workspace>/vault  → fixture\n"
          }
        }
      ]
    },
    {
      "name": "source-list",
      "workspace": "alchemy",
      "argv": [
        "source",
        "list"
      ],
      "expect": {
        "exit": 0,
        "stdout": "  fixture-fs  fs  <workspace>/vault  → fixture\n"
      }
    },
    {
      "name": "source-list-json",
      "workspace": "alchemy",
      "argv": [
        "source",
        "list",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout": "[{\"name\":\"fixture-fs\",\"adapter\":\"fs\",\"config\":{\"root\":\"<workspace>/vault\"},\"repos\":[\"fixture\"]}]\n"
      }
    },
    {
      "name": "source-list-jsonl",
      "workspace": "alchemy",
      "argv": [
        "source",
        "list",
        "--jsonl"
      ],
      "expect": {
        "exit": 0,
        "stdout": "{\"name\":\"fixture-fs\",\"adapter\":\"fs\",\"config\":{\"root\":\"<workspace>/vault\"},\"repos\":[\"fixture\"]}\n"
      }
    },
    {
      "name": "source-list-ids",
      "workspace": "alchemy",
      "argv": [
        "source",
        "list",
        "--ids"
      ],
      "expect": {
        "exit": 0,
        "stdout": "fixture-fs\n"
      }
    },
    {
      "name": "source-detach-attach",
      "workspace": "alchemy",
      "steps": [
        {
          "argv": [
            "source",
            "detach",
            "fixture-fs"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  ok detached fixture-fs ⇸ fixture\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  fixture-fs  fs  <workspace>/vault  (unattached)\n"
          }
        },
        {
          "argv": [
            "repos"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  * fixture  (no source)  20 docs  327 blocks\n"
          }
        },
        {
          "argv": [
            "source",
            "attach",
            "fixture-fs",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"source\":\"fixture-fs\",\"repo\":\"fixture\",\"attached\":true}\n"
          }
        },
        {
          "argv": [
            "source",
            "detach",
            "fixture-fs",
            "--json"
          ],
          "expect": {
            "exit": 0,
            "stdout": "{\"source\":\"fixture-fs\",\"repo\":\"fixture\",\"attached\":false}\n"
          }
        },
        {
          "argv": [
            "source",
            "attach",
            "fixture-fs"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  ok attached fixture-fs → fixture\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  fixture-fs  fs  <workspace>/vault  → fixture\n"
          }
        }
      ]
    },
    {
      "name": "source-attach-missing",
      "workspace": "alchemy",
      "argv": [
        "source",
        "attach",
        "nope"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[target_missing]: no source named 'nope'\n"
      }
    },
    {
      "name": "source-detach-no-name",
      "workspace": "alchemy",
      "argv": [
        "source",
        "detach"
      ],
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "usage: source detach requires a <name>\n"
      }
    },
