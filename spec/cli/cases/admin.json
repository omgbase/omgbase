            "source",
            "rm",
            "fixture-fs"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  ok deleted source fixture-fs\n"
          }
        },
        {
          "argv": [
            "source",
            "list"
          ],
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
