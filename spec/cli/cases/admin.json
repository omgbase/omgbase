            "stdout": "  out\n    references > d_13 ×1\n  in (backlinks)\n    d_0 > references ×1\n"
          }
        },
        {
          "argv": [
            "find",
            "emerald",
            "-n",
            "1"
          ],
          "expect": {
            "exit": 0,
            "stdout": "b_289  /texts/emerald-tablet.md#heading[0]  The Emerald Tablet\n"
          }
        },
        {
          "argv": [
            "doctor"
          ],
          "expect": {
            "exit": 0,
            "stdout": "  ok convergence\n  ok fts rows == live leaf blocks\n  ok no dangling current_rev\n  ok sqlite integrity\n"
          }
        }
      ]
    },
    {
      "name": "gc-refused",
      "notes": "§6: refuses unless gc.enabled; §9: under the code target_missing",
      "workspace": "alchemy",
      "argv": [
        "gc"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "error[target_missing]: gc is disabled; set gc.enabled=true (or use --dry-run)\n"
      }
    },
    {
      "name": "gc-refused-json",
      "workspace": "alchemy",
      "argv": [
        "gc",
        "--json"
      ],
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "{\"error\":\"target_missing\",\"message\":\"gc is disabled; set gc.enabled=true (or use --dry-run)\",\"retriable\":false}\n"
      }
    },
    {
      "name": "gc-dry-run",
      "workspace": "alchemy",
      "argv": [
        "gc",
        "--dry-run"
      ],
      "pin_stderr": true,
      "expect": {
        "exit": 0,
        "stdout": "",
