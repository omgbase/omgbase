    {
      "name": "no-features-no-nodes",
      "notes": "Plain prose without a heading projects no node at all.",
      "steps": [
        {
          "observe": {
            "ts": "2026-09-26T10:00:00.000Z",
            "items": [
              {
                "path": "a.md",
                "source": "Just prose.\n"
              }
            ]
          }
        }
      ],
      "expect": {
        "nodes": [],
        "external_nodes": [],
        "edges": [],
        "doc_edges": []
      }
    },
