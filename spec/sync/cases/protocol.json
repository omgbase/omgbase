{
  "suite": "protocol",
  "cases": [
    {
      "name": "handshake-and-enumerate",
      "kind": "adapter",
      "notes": "README §5: the first line is the handshake; requests carry increasing ids from 1 with a params object (empty for enumerate).",
      "transcript": [
        {
          "dir": "in",
          "line": "{\"protocol\":1,\"capabilities\":{\"identity\":\"inferred\",\"writeThrough\":true,\"watch\":true}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":1,\"method\":\"enumerate\",\"params\":{}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":1,\"result\":{\"entries\":[{\"path\":\"a.md\",\"revision\":\"1000:4\"},{\"path\":\"sub/b.md\",\"revision\":\"1000:4\",\"sourceId\":\"b\"}]}}"
        }
      ],
      "expect": {
        "capabilities": {
          "identity": "inferred",
          "write_through": true,
          "watch": true
        },
        "results": [
          {
            "entries": [
              {
                "path": "a.md",
                "revision": "1000:4"
              },
              {
                "path": "sub/b.md",
                "revision": "1000:4",
                "sourceId": "b"
              }
            ]
          }
        ],
        "events": []
      }
    },
    {
      "name": "fetch-present-and-absent",
