    {
      "name": "reconcile-echo-edit-and-gone",
      "kind": "coordinator",
      "notes": "An unchanged path is suppressed (echo), an edited one ingested, a path the source no longer has goes to observe_delete (deleted only when a live doc existed).",
      "source": {
        "write_through": true
      },
      "steps": [
        {
          "source": {
            "set": {
              "a.md": "# A\n\nAlpha paragraph about apples and the orchard rows along the valley road.\n",
              "b.md": "# B\n\nBeta paragraph about bees and the hives at the edge of the meadow.\n"
            }
          }
        },
        {
          "sync_in": {
            "ts": "2026-09-26T10:00:00.000Z"
          }
        },
        {
          "source": {
            "set": {
              "b.md": "# B\n\nBeta paragraph about bees and the hives at the far edge of the meadow.\n"
            },
            "rm": [
              "a.md"
            ]
          }
        },
        {
          "reconcile": {
            "ts": "2026-09-26T10:01:00.000Z",
            "paths": [
              "a.md",
              "b.md",
              "never.md"
            ]
          }
        }
      ],
      "expect": {
        "steps": [
          {},
          {
            "ingested": [
              "a.md",
              "b.md"
            ],
            "suppressed": [],
            "conflicted": [],
            "deleted": [],
            "calls": [
              {
                "source": "enumerate"
              },
              {
                "source": "fetch",
                "path": "a.md"
              },
              {
                "source": "fetch",
                "path": "b.md"
              },
              {
                "engine": "observe_many",
                "files": [
                  {
                    "path": "a.md",
                    "content": "# A\n\nAlpha paragraph about apples and the orchard rows along the valley road.\n"
                  },
                  {
                    "path": "b.md",
                    "content": "# B\n\nBeta paragraph about bees and the hives at the edge of the meadow.\n"
                  }
                ]
              }
            ]
          },
          {},
          {
            "ingested": [
              "b.md"
            ],
            "suppressed": [],
            "conflicted": [],
            "deleted": [
              "a.md"
            ],
            "calls": [
              {
                "source": "fetch",
                "path": "a.md"
              },
              {
                "source": "fetch",
                "path": "b.md"
              },
              {
                "source": "fetch",
                "path": "never.md"
              },
              {
                "engine": "observe_many",
                "files": [
                  {
                    "path": "b.md",
                    "content": "# B\n\nBeta paragraph about bees and the hives at the far edge of the meadow.\n"
                  }
                ]
              },
              {
                "engine": "observe_delete",
                "path": "a.md"
              },
              {
                "engine": "observe_delete",
                "path": "never.md"
              }
            ]
          }
        ],
        "files": {
          "b.md": "# B\n\nBeta paragraph about bees and the hives at the far edge of the meadow.\n"
        },
        "docs": [
