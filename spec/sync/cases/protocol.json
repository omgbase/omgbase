    {
      "name": "sync-out-skips-observed-writes-api-and-import",
      "kind": "coordinator",
      "notes": "README §6 sync_out: observed commits are never exported; api and import commits alike are (§9); each revision's doc is re-read by path and written.",
      "source": {
        "write_through": true
      },
      "steps": [
        {
          "source": {
            "set": {
              "from-source.md": "# From the source\n"
            }
          }
        },
        {
          "sync_in": {
            "ts": "2026-09-26T10:00:00.000Z"
          }
        },
        {
          "engine": {
            "ts": "2026-09-26T10:01:00.000Z",
            "create": {
              "path": "authored.md",
              "markdown": "# Authored\n\nWritten through the API.\n",
              "actor": "agent:test"
            }
          }
        },
        {
          "engine": {
            "ts": "2026-09-26T10:02:00.000Z",
            "import": {
              "path": "imported.md",
              "content": "# Imported\n"
            }
          }
        },
        {
          "sync_out": {}
        }
      ],
      "expect": {
        "steps": [
          {},
          {
            "ingested": [
              "from-source.md"
            ],
            "suppressed": [],
            "conflicted": [],
            "deleted": [],
            "calls": [
              {
                "source": "enumerate"
              },
              {
                "source": "fetch",
                "path": "from-source.md"
              },
              {
                "engine": "observe_many",
                "files": [
                  {
                    "path": "from-source.md",
                    "content": "# From the source\n"
                  }
                ]
              }
            ]
          },
          {
            "doc": "d_1",
            "committed": true
          },
          {
            "doc": "d_2",
            "commit": "c_2"
          },
          {
            "cursor": 3,
            "written": [
              "authored.md",
              "imported.md"
            ],
            "removed": [],
            "calls": [
              {
                "engine": "changes_since",
                "cursor": 0
              },
              {
                "engine": "read_doc",
                "path": "authored.md"
              },
              {
                "source": "write",
                "path": "authored.md",
                "content": "# Authored\n\nWritten through the API.\n"
              },
              {
                "engine": "read_doc",
                "path": "imported.md"
              },
              {
                "source": "write",
                "path": "imported.md",
                "content": "# Imported\n"
              }
            ]
          }
        ],
        "files": {
          "authored.md": "# Authored\n\nWritten through the API.\n",
          "from-source.md": "# From the source\n",
          "imported.md": "# Imported\n"
        },
        "docs": [
          {
            "doc_id": "d_1",
            "path": "authored.md",
