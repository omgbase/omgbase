        }
      ],
      "expect": {
        "capabilities": {
          "identity": "inferred",
          "write_through": false,
          "watch": false
        },
        "results": [
          {
            "item": {
              "path": "a.md",
              "revision": "1000:4",
              "content": "# A\n"
            }
          },
          {
            "item": null
          },
          {
            "item": null
          }
        ],
        "events": []
      }
    },
    {
      "name": "write-and-remove",
      "kind": "adapter",
      "notes": "writeThrough sources take write { path, content } and remove { path }; the engine passes the bytes verbatim.",
      "transcript": [
        {
          "dir": "in",
          "line": "{\"protocol\":1,\"capabilities\":{\"identity\":\"inferred\",\"writeThrough\":true,\"watch\":false}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":1,\"method\":\"write\",\"params\":{\"path\":\"new/x.md\",\"content\":\"# X\\n\\nBody with \\\"quotes\\\" and unicode — é\\n\"}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":1,\"result\":{\"ok\":true}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":2,\"method\":\"remove\",\"params\":{\"path\":\"old.md\"}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":2,\"result\":{\"ok\":true}}"
        }
      ],
      "expect": {
        "capabilities": {
          "identity": "inferred",
          "write_through": true,
          "watch": false
        },
        "results": [
          {
            "ok": true
          },
          {
            "ok": true
          }
        ],
        "events": []
      }
    },
    {
      "name": "watch-events-unwatch",
      "kind": "adapter",
      "notes": "After watch, unsolicited {\"event\":\"batch\"} lines reach the listener in order; unwatch stops the feed.",
      "transcript": [
        {
          "dir": "in",
          "line": "{\"protocol\":1,\"capabilities\":{\"identity\":\"inferred\",\"writeThrough\":true,\"watch\":true}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":1,\"method\":\"watch\",\"params\":{}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":1,\"result\":{\"ok\":true}}"
        },
        {
          "dir": "in",
          "line": "{\"event\":\"batch\",\"paths\":[\"a.md\"]}"
        },
        {
          "dir": "in",
          "line": "{\"event\":\"batch\",\"paths\":[\"b.md\",\"sub/c.md\"]}"
        },
        {
          "dir": "out",
          "line": "{\"id\":2,\"method\":\"unwatch\",\"params\":{}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":2,\"result\":{\"ok\":true}}"
        }
      ],
      "expect": {
        "capabilities": {
          "identity": "inferred",
          "write_through": true,
          "watch": true
        },
        "results": [
          {
            "ok": true
          },
          {
            "ok": true
          }
        ],
        "events": [
          {
            "event": "batch",
            "paths": [
              "a.md"
            ]
          },
          {
            "event": "batch",
            "paths": [
              "b.md",
              "sub/c.md"
            ]
          }
        ]
      }
    },
    {
      "name": "watch-ready-then-events",
      "kind": "adapter",
      "notes": "README §5 readiness (1.2): after the watch response the adapter reports {\"event\":\"ready\"} once its feed is primed, then batches; the listener receives both as events in wire order; unwatch stops the feed.",
      "transcript": [
        {
          "dir": "in",
          "line": "{\"protocol\":1,\"capabilities\":{\"identity\":\"inferred\",\"writeThrough\":true,\"watch\":true}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":1,\"method\":\"watch\",\"params\":{}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":1,\"result\":{\"ok\":true}}"
        },
        {
          "dir": "in",
          "line": "{\"event\":\"ready\"}"
        },
        {
          "dir": "in",
          "line": "{\"event\":\"batch\",\"paths\":[\"a.md\"]}"
        },
        {
          "dir": "out",
          "line": "{\"id\":2,\"method\":\"unwatch\",\"params\":{}}"
        },
        {
          "dir": "in",
          "line": "{\"id\":2,\"result\":{\"ok\":true}}"
        }
      ],
      "expect": {
        "capabilities": {
          "identity": "inferred",
          "write_through": true,
          "watch": true
        },
        "results": [
          {
            "ok": true
          },
          {
            "ok": true
          }
        ],
        "events": [
          {
            "event": "ready"
          },
          {
            "event": "batch",
            "paths": [
              "a.md"
            ]
          }
        ]
      }
    },
