          "dir": "in",
          "line": "{\"id\":2,\"result\":{\"item\":null}}"
        },
        {
          "dir": "out",
          "line": "{\"id\":3,\"method\":\"fetch\",\"params\":{\"path\":\"a.md\"}}"
