    {
      "name": "sync-in-ingests",
      "kind": "coordinator",
      "notes": "README §6 sync_in = reconcile(enumerate().paths): every entry is fetched, present items go to observe_many in one call.",
      "source": {
        "write_through": true
      },
      "steps": [
        {
          "source": {
            "set": {
              "a.md": "# A\n\nAlpha paragraph about apples and the orchard rows along the valley road.\n",
              "sub/b.md": "# B\n\nBeta paragraph about bees and the hives at the edge of the meadow.\n"
            }
          }
        },
        {
          "sync_in": {
            "ts": "2026-09-26T10:00:00.000Z"
          }
        }
      ],
      "expect": {
        "steps": [
          {},
          {
            "ingested": [
              "a.md",
              "sub/b.md"
            ],
            "suppressed": [],
            "conflicted": [],
            "deleted": [],
            "calls": [
              {
                "source": "enumerate"
              },
              {
                "source": "fetch",
                "path": "a.md"
              },
              {
                "source": "fetch",
                "path": "sub/b.md"
              },
              {
                "engine": "observe_many",
                "files": [
                  {
                    "path": "a.md",
                    "content": "# A\n\nAlpha paragraph about apples and the orchard rows along the valley road.\n"
                  },
                  {
                    "path": "sub/b.md",
                    "content": "# B\n\nBeta paragraph about bees and the hives at the edge of the meadow.\n"
                  }
                ]
              }
            ]
          }
        ],
        "files": {
          "a.md": "# A\n\nAlpha paragraph about apples and the orchard rows along the valley road.\n",
          "sub/b.md": "# B\n\nBeta paragraph about bees and the hives at the edge of the meadow.\n"
        },
        "docs": [
          {
            "doc_id": "d_0",
            "path": "a.md",
            "deleted": false
          },
          {
            "doc_id": "d_1",
            "path": "sub/b.md",
            "deleted": false
          }
        ],
        "commits": [
          {
            "commit_id": "c_0",
            "seq": 1,
            "origin": "observed",
            "actor": null
          },
          {
            "commit_id": "c_1",
            "seq": 2,
            "origin": "observed",
            "actor": null
