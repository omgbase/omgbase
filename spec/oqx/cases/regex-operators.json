{
  "suite": "regex-operators",
  "notes": "The infix regex operators (since 0.22): `a ~ b` ≡ `a.matches(b)`, `a ~* b` ≡ `a.matches(b, \"i\")`, `a !~ b` ≡ `!a.matches(b)`, `a !~* b` ≡ `!a.matches(b, \"i\")`. Pure sugar over SEMANTICS §11's `matches` — same regex baseline, same unanchored search, same string forms, same absent rule (an absent receiver matches nothing, so `~` is false and `!~` is TRUE; not SQL's NULL) — at comparison precedence, non-associative, parsed to a `binary` node carrying the operator as written.",
  "cases": [
    {
      "name": "parse: `~` is a binary node carrying the operator",
      "tags": [
        "ast",
        "regex-operators"
      ],
      "query": "select a: title ~ \"^Eng\" from people",
      "expect": {
        "ast": {
          "kind": "query",
          "source": {
            "kind": "ident",
            "name": "people"
          },
          "from": [],
          "where": null,
          "select": [
            {
              "kind": "field",
              "name": "a",
              "expr": {
                "kind": "binary",
                "op": "~",
                "left": {
                  "kind": "ident",
                  "name": "title"
                },
                "right": {
                  "kind": "lit",
                  "value": "^Eng"
                }
              },
              "lift": 0
            }
          ],
          "orderBy": null,
          "consumer": "collect",
          "follow": null,
          "flatten": [],
          "groupBy": null,
          "having": null,
          "frontier": null,
          "distinct": false,
          "values": false,
          "limit": null,
          "offset": null
        }
      }
    },
