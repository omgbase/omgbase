    {
      "name": "values takes exactly one item",
      "query": "name, id values from people",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "exactly one"
          ]
        }
      }
    },
    {
      "name": "values rejects a lift",
      "query": "from people where jobs collect { ^x: employer values }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "lift"
          ]
        }
      }
    }
