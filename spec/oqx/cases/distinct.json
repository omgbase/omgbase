    {
      "name": "distinct with follow collapses repeated projections",
      "notes": "The walk yields 1, 2, 1 (the last a cycle occurrence); `select distinct` dedups the projections.",
      "roots": {
        "g": [
          {
            "id": 1,
            "next": [
              {
                "id": 2,
                "next": [
                  {
                    "id": 1,
                    "next": []
                  }
                ]
              }
            ]
          }
        ]
      },
      "query": "select distinct id from g follow next order by id",
      "expect": {
        "result": [
          {
            "id": 1
          },
          {
            "id": 2
          }
        ]
      }
