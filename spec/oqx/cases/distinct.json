{
  "suite": "distinct",
  "cases": [
    {
      "name": "select distinct dedups by projection",
      "roots": {
        "dupes": [
          {
            "id": 1
          },
          {
            "id": 1
          },
          {
            "id": 2
          }
        ]
      },
      "query": "select distinct id from dupes",
      "expect": {
        "result": [
          {
            "id": 1
          },
          {
            "id": 2
          }
        ]
      }
    },
    {
      "name": "select distinct keeps first occurrence order",
      "roots": {
        "jobs": [
          {
            "employer": "Globocorp",
            "start_date": "1984/05/01",
            "end_date": "1990/01/01"
          },
          {
            "employer": "Globocorp",
            "start_date": "2001/03/01"
          },
          {
            "employer": "Initech",
            "start_date": "1999/01/01",
            "end_date": "2005/01/01"
          },
          {
            "employer": "Globocorp",
            "start_date": "2010/06/01",
            "end_date": "2015/01/01"
          },
          {
            "employer": "Globocorp",
            "start_date": "2020/01/01"
          }
        ]
      },
      "query": "select distinct employer from jobs",
      "expect": {
        "result": [
          {
            "employer": "Globocorp"
          },
          {
            "employer": "Initech"
          }
        ]
      }
    },
