{
  "suite": "alias-scope",
  "cases": [
    {
      "name": "order by reads a select alias",
      "tags": [
        "alias",
        "order"
      ],
      "notes": "Since 0.27 every clause that reads a body's rows sees that body's `select` aliases: `order by n` sorts by `name`. Through 0.26 only `where`, `having` and the items to an item's right did.",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
              {
                "id": 2,
                "ok": true
              },
              {
                "id": 3,
                "ok": false
              }
            ]
          },
          {
            "id": 2,
            "name": "Al",
            "kind": "eng",
            "age": 30,
            "n": "aaa",
            "children": []
          },
          {
            "id": 3,
            "name": "Cy",
            "kind": "ops",
            "age": 52,
            "n": "mmm",
            "children": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      },
      "query": "people { select n: name order by n }",
      "expect": {
        "result": [
          {
            "n": "Al"
          },
          {
            "n": "Bob"
          },
          {
            "n": "Cy"
          }
        ]
      }
    },
    {
      "name": "an alias shadows the row field it is named after; $it.<name> reads the field",
      "tags": [
        "alias",
        "order",
        "intrinsic"
      ],
      "notes": "`n: name` hides the row's own `n` from every row-reading clause; `$it.n` is the row's property regardless. (`order by n` here would sort by `name`.)",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
              {
                "id": 2,
                "ok": true
              },
              {
                "id": 3,
                "ok": false
              }
            ]
          },
          {
            "id": 2,
            "name": "Al",
            "kind": "eng",
            "age": 30,
            "n": "aaa",
            "children": []
          },
          {
            "id": 3,
            "name": "Cy",
            "kind": "ops",
            "age": 52,
            "n": "mmm",
            "children": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      },
      "query": "people { select n: name, raw: $it.n order by $it.n }",
      "expect": {
        "result": [
          {
            "n": "Al",
            "raw": "aaa"
          },
          {
            "n": "Cy",
            "raw": "mmm"
          },
          {
            "n": "Bob",
            "raw": "zzz"
          }
        ]
      }
    },
    {
      "name": "where reads a block alias inside an expression",
      "tags": [
        "alias",
        "where",
        "nested"
      ],
      "notes": "A block alias inlines as a value-position directive wherever it is read — `kids.size()` is `children { where ok }.size()`; alone as a `where` leaf it still means non-empty. An error through 0.26.",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
              {
                "id": 2,
                "ok": true
              },
              {
                "id": 3,
                "ok": false
              }
            ]
          },
          {
            "id": 2,
            "name": "Al",
            "kind": "eng",
            "age": 30,
            "n": "aaa",
            "children": []
          },
          {
            "id": 3,
            "name": "Cy",
            "kind": "ops",
            "age": 52,
            "n": "mmm",
            "children": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      },
      "query": "people { select name, kids: children { where ok } where kids.size() == 1 }",
      "expect": {
        "result": [
          {
            "name": "Bob",
            "kids": [
              {
                "id": 2,
                "ok": true
              }
            ]
          },
          {
            "name": "Cy",
            "kids": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "follow reads a block alias as a destination",
      "tags": [
        "alias",
        "follow",
        "nested"
      ],
      "notes": "`follow kids` walks `children { where ok }` from each frontier row — the alias's block, re-read on the row being expanded (the seed's `kids` are its ok children; Al has none).",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
              {
                "id": 2,
                "ok": true
              },
              {
                "id": 3,
                "ok": false
              }
            ]
          },
          {
            "id": 2,
            "name": "Al",
            "kind": "eng",
            "age": 30,
            "n": "aaa",
            "children": []
          },
          {
            "id": 3,
            "name": "Cy",
            "kind": "ops",
            "age": 52,
            "n": "mmm",
            "children": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      },
      "query": "people { select id, kids: children { where ok } where id == 1 follow kids { $key: id } order by $ordinal }",
      "expect": {
        "result": [
          {
            "id": 1,
            "kids": [
              {
                "id": 2,
                "ok": true
              }
            ]
          },
          {
            "id": 2,
            "kids": []
          }
        ]
      }
    },
