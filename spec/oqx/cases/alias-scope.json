    {
      "name": "a block alias read through ^ inlines its block shifted",
      "tags": [
        "alias",
        "nested",
        "outer"
      ],
      "notes": "`^kids` in the count block is the root body's alias, inlined shifted — `^children { where ok }`, the enclosing row's ok children — so `n` counts the people those children name (`^id` inside the exists block is the counted person).",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
              {
                "id": 2,
                "ok": true
              },
              {
                "id": 3,
                "ok": false
              }
            ]
          },
          {
            "id": 2,
            "name": "Al",
            "kind": "eng",
            "age": 30,
            "n": "aaa",
            "children": []
          },
          {
            "id": 3,
            "name": "Cy",
            "kind": "ops",
            "age": 52,
            "n": "mmm",
            "children": [
              {
                "id": 1,
                "ok": true
              }
            ]
          }
        ]
      },
      "query": "people { select id, kids: children { where ok }, n: ^people count { where ^kids exists { where id == ^id } } }",
      "expect": {
        "result": [
          {
            "id": 1,
            "kids": [
              {
                "id": 2,
                "ok": true
              }
            ],
            "n": 1
          },
          {
            "id": 2,
            "kids": [],
            "n": 0
          },
          {
            "id": 3,
            "kids": [
              {
                "id": 1,
                "ok": true
              }
            ],
            "n": 1
          }
        ]
      }
    },
