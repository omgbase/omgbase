    {
      "name": "from is never rewritten: a bare alias name there is the row field",
      "tags": [
        "alias",
        "from"
      ],
      "notes": "`from` produces the rows the `select` reads, so the select cannot name it: `from c` reads the row's `c` (absent), and the row yields nothing.",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "kind": "eng",
            "age": 41,
            "n": "zzz",
            "children": [
