    {
      "name": "top-level where without intrinsics selects seeds",
      "roots": {
        "tree": [
          {
            "id": "root",
            "label": "Root",
            "children": [
              {
                "id": "a",
                "label": "A",
                "children": [
                  {
                    "id": "a1",
