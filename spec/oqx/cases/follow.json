                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "query": "id values from c follow next",
      "expect": {
        "result": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    },
    {
      "name": "the capped row reports depth",
      "roots": {
        "c": [
          {
            "id": 1,
            "next": [
              {
                "id": 2,
                "next": [
                  {
                    "id": 3,
                    "next": [
                      {
                        "id": 4,
                        "next": [
                          {
                            "id": 5,
                            "next": [
                              {
                                "id": 6,
                                "next": [
                                  {
                                    "id": 7,
                                    "next": [
                                      {
                                        "id": 8,
                                        "next": [
                                          {
                                            "id": 9,
                                            "next": [
                                              {
                                                "id": 10,
                                                "next": []
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "query": "id, s: $stop, f: $frontier from c follow next order by $ordinal offset 6",
      "expect": {
        "result": [
          {
            "id": 7,
            "s": "interior",
            "f": false
          },
          {
            "id": 8,
            "s": "depth",
            "f": true
          }
        ]
      }
    },
    {
      "name": "frontier cuts a relation that could continue",
      "roots": {
        "tree": [
          {
            "id": "root",
            "label": "Root",
            "children": [
              {
                "id": "a",
                "label": "A",
                "children": [
                  {
                    "id": "a1",
                    "label": "A1",
                    "children": []
                  }
                ]
              },
              {
                "id": "b",
                "label": "B",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "id, s: $stop, f: $frontier, l: $leaf from tree follow children { frontier id == \"a\" } order by $ordinal",
      "expect": {
        "result": [
          {
            "id": "root",
            "s": "interior",
            "f": false,
            "l": false
          },
          {
            "id": "a",
            "s": "frontier",
            "f": true,
            "l": false
          },
          {
            "id": "b",
            "s": "leaf",
            "f": false,
            "l": true
          }
        ]
      }
    },
    {
      "name": "where in the follow block filters successors",
