    },
    {
      "name": "top-level where with intrinsics filters after the walk",
      "roots": {
        "tree": [
          {
            "id": "root",
            "label": "Root",
            "children": [
              {
                "id": "a",
                "label": "A",
                "children": [
                  {
                    "id": "a1",
                    "label": "A1",
                    "children": []
