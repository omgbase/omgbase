        ]
      },
      "query": "people { select name, d: jobs count distinct, e: jobs { employer } count distinct order by name }",
      "expect": {
        "result": [
          {
            "name": "Alice",
            "d": 1,
            "e": 1
          },
          {
            "name": "Bob",
            "d": 2,
            "e": 2
          },
          {
            "name": "Carol",
            "d": 0,
            "e": 0
          }
        ]
      },
      "tags": [
        "bare",
        "distinct"
      ],
      "notes": "`count distinct` with no block dedups the rows by identity; `jobs { employer } count distinct` counts the distinct projections of the inner block."
