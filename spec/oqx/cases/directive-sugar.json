{
  "suite": "directive-sugar",
  "cases": [
    {
      "name": "a consumer word alone is the directive over the empty block",
      "roots": {
        "people": [
          {
            "id": 1,
            "name": "Bob",
            "jobs": [
              {
                "employer": "Globocorp",
                "pay": 3,
                "end": true
              },
              {
                "employer": "Initech",
                "pay": 1
              }
            ]
          },
          {
            "id": 2,
            "name": "Alice",
            "jobs": [
              {
                "employer": "Initech",
                "pay": 5
              }
            ]
          },
          {
            "id": 3,
            "name": "Carol",
            "jobs": []
          }
        ]
      },
      "query": "people { select name, n: jobs count, f: jobs first order by name }",
      "expect": {
        "result": [
          {
            "name": "Alice",
            "n": 1,
            "f": {
              "employer": "Initech",
              "pay": 5
            }
          },
          {
            "name": "Bob",
            "n": 2,
            "f": {
              "employer": "Globocorp",
              "pay": 3,
              "end": true
            }
          },
          {
            "name": "Carol",
            "n": 0,
            "f": null
          }
        ]
      },
      "tags": [
        "bare",
        "count",
        "first"
      ],
      "notes": "Since 0.26 `jobs count` ≡ `jobs count { }` and `jobs first` ≡ `jobs first { }`: a consumer word right after a complete receiver can be nothing else."
    },
    {
      "name": "exists and none without a block in where",
