    {
      "name": "a bare lookup alone in where is still the select-position error",
      "query": "people { where jobs first }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "select-position lookup"
          ]
        }
      },
      "tags": [
        "bare",
        "errors"
      ]
    },
    {
      "name": "a bare consumer at the top level takes no comparison",
      "query": "people count > 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "after the top-level directive"
          ]
        }
      },
      "tags": [
        "bare",
        "errors"
      ],
      "notes": "`count { … } <relop> N` is a where-position test; a whole-query `count` is the number."
    },
    {
      "name": "the clause form keeps its whole-query hint",
      "query": "from people count",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected `count` after `from`",
            "<collection> count { … }"
          ]
        }
      },
      "tags": [
        "bare",
        "errors",
        "legacy"
      ],
      "notes": "Inside the clause form's top-level `from` a consumer word is not read as a braceless directive (a count is never a source); the hint names the directive form."
    },
