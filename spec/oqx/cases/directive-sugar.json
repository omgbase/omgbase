        ]
      },
      "query": "people { select name where jobs exists and !jobs none order by name }",
      "expect": {
        "result": [
          {
            "name": "Alice"
          },
          {
            "name": "Bob"
          }
        ]
      },
      "tags": [
        "bare",
        "exists",
        "none"
      ]
    },
