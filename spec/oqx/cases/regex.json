      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "not supported in OQX regular expressions",
            "negative lookbehind (?<!…)"
          ]
        }
      }
    },
    {
      "name": "matches rejects a backreference",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"aa\".matches(\"(a)\\\\1\") }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "not supported in OQX regular expressions",
            "a backreference (\\1)"
