        "people": [
          {
            "name": "Bob",
            "id": 124,
            "title": "Engineer",
            "active": true,
            "age": 41,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "1984/05/01",
                "end_date": "1990/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2001/03/01"
              }
            ]
          },
          {
            "name": "Alice",
            "id": 7,
            "title": "Director",
            "active": true,
            "age": 52,
            "jobs": [
              {
                "employer": "Initech",
                "start_date": "1999/01/01",
                "end_date": "2005/01/01"
