          "includes": [
            "invalid regular expression"
          ]
        }
      }
    },
    {
      "name": "matches rejects lookahead",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"ab\".matches(\"a(?=b)\") }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "not supported in OQX regular expressions",
            "lookahead (?=…)"
          ]
        }
      }
    },
    {
      "name": "matches rejects negative lookahead",
      "roots": {
        "r": [
          {}
        ]
      },
