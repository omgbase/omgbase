    {
      "name": "matches dot and escaped dot",
      "notes": "The query source contains `a\\.b`: the OQX string escape yields a backslash, which the regex reads as an escaped dot.",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"a.b\".matches(\"a\\\\.b\") && !\"axb\".matches(\"a\\\\.b\") }",
      "expect": {
        "result": true
      }
    },
    {
