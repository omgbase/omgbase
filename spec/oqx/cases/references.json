{
  "suite": "references",
  "cases": [
    {
      "name": "bare names in select and where, scoped to the source rows",
      "tags": [
        "select",
        "where"
      ],
      "notes": "Every bare identifier is a reference to the current row; the scope's one step is the query's source, producing rows at depth 1.",
      "query": "select name, age from people where age >= 18",
      "expect": {
        "references": [
          {
            "name": "name",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "age",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          }
        ]
      }
    },
    {
      "name": "the head of the top-level source is a root name",
      "tags": [
        "source",
        "root"
      ],
      "notes": "Reported at depth 0 with no steps: nothing is read from a row at the root scope, the host knows its roots.",
      "query": "from people",
      "expect": {
        "references": [
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          }
        ]
      }
    },
    {
      "name": "a dotted navigation is one reference with its full path",
      "tags": [
        "member"
      ],
      "notes": "`meta.owner` is one reference, not `meta` plus `owner`; the host splits it as its data model requires.",
      "query": "select owner: meta.owner from docs where meta.owner == \"x\"",
      "expect": {
        "references": [
          {
            "name": "meta.owner",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "docs",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "docs",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          },
          {
            "name": "meta.owner",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "docs",
                  "depth": 1
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "a method call references its receiver, never its name",
      "tags": [
        "call"
      ],
      "notes": "`lower`, `has` and `size` are not references; `title`, `stage` and `jobs` are.",
      "query": "from docs where title.lower() == \"x\" and has(stage) and size(jobs) > 1",
      "expect": {
        "references": [
          {
            "name": "docs",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          },
          {
            "name": "title",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "docs",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "stage",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "docs",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "jobs",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "docs",
                  "depth": 1
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "a binding is a host value, not a reference",
      "tags": [
        "binding"
      ],
      "template": {
        "strings": [
          "name from people where employer == ",
          " and age > ",
          ""
        ],
        "values": [
          "Globocorp",
          30
        ]
      },
      "expect": {
        "references": [
          {
            "name": "name",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          },
          {
            "name": "employer",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "age",
            "clause": "where",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "a select alias is not a reference in where; a row field of the same name inside its own item is",
      "tags": [
        "alias",
        "where"
      ],
      "notes": "SEMANTICS §14: `senior` and `n` in `where` are substituted by the language, so they are the aliases' expressions, not row properties; `name` inside `name: name.upper()` is the row field.",
      "query": "select name: name.upper(), senior: age > 50 from people where senior and name == \"X\"",
      "expect": {
        "references": [
          {
            "name": "name",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "age",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          }
        ]
      }
    },
    {
      "name": "a later item reading an earlier alias is not a reference; the alias's own expression is",
      "tags": [
        "alias",
        "select"
      ],
      "query": "select a: x, b: a + y from people",
      "expect": {
        "references": [
          {
            "name": "x",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "y",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          }
        ]
      }
    },
    {
      "name": "order by is not rewritten against aliases, so an alias there is a row property",
      "tags": [
        "alias",
        "orderBy"
      ],
      "notes": "SEMANTICS §17: `order by n` reads the row's `n`, whatever `select` named — reported so a host can say the row has none.",
      "query": "select n: name from people order by n",
      "expect": {
        "references": [
          {
            "name": "name",
            "clause": "select",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          },
          {
            "name": "people",
            "clause": "source",
            "scope": {
              "depth": 0,
              "steps": []
            }
          },
          {
            "name": "n",
            "clause": "orderBy",
            "scope": {
              "depth": 1,
              "steps": [
                {
                  "expr": "people",
                  "depth": 1
                }
              ]
            }
          }
        ]
      }
    },
