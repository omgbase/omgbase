{
  "suite": "errors-parse",
  "cases": [
    {
      "name": "dangling dot",
      "query": "name. from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "after '.'"
          ]
        }
      }
    },
    {
      "name": "dangling operator",
      "query": "from r where a ==",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected a value"
          ]
        }
      }
    },
    {
      "name": "unbalanced parenthesis in where",
      "query": "from r where (a == 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected ')'"
          ]
        }
      }
    },
    {
      "name": "unbalanced parenthesis in a value",
      "query": "x: (1 + 2 from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected ')'"
          ]
        }
      }
    },
    {
      "name": "stray closing brace",
      "query": "from r }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected '}'"
          ]
        }
      }
    },
    {
      "name": "block without a receiver",
      "query": "count { } from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected '{'"
          ]
        }
      }
    },
    {
      "name": "consumer after a projection is not a predicate",
      "query": "people first { name, jobs exists { } }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "write `where <relation> exists { … }`"
          ]
        }
      },
      "notes": "After a projection a consumer test still needs `where`; a block may lead with a predicate only when nothing is projected (0.17)."
    },
    {
      "name": "nested block in a projection needs a name",
      "query": "people first { jobs collect { } }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "needs a name"
          ]
        }
      }
    },
    {
      "name": "follow block unclosed",
      "query": "id from tree follow children { depth 2",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected '}' to close the follow block"
          ]
        }
      }
    },
    {
      "name": "outer reference needs a name",
      "query": "from r where ^ == 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected an identifier after '^'"
          ]
        }
      }
    },
    {
      "name": "a where clause cannot be empty before a block",
      "query": "people exists { where }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected a value"
          ]
        }
      }
    },
    {
      "name": "order by direction must follow the expression",
      "query": "name from people order by desc age",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected 'age'"
          ]
        }
      }
    },
    {
      "name": "follow distinct needs a relation",
      "notes": "After `follow`, `distinct` is a keyword; a relation literally named `distinct` is not supported.",
      "roots": {
        "tree": [
          {
            "id": "root",
            "children": [
              {
                "id": "a",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "id from tree follow distinct { depth 2 }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected a relation after `follow distinct`"
          ]
        }
      }
    },
    {
      "name": "follow distinct at the end of the query",
      "roots": {
        "tree": [
          {
            "id": "root",
            "children": [
              {
                "id": "a",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "id from tree follow distinct",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "expected a relation after `follow distinct`"
          ]
        }
      }
    },
    {
      "name": "follow does not take an outer reference",
      "roots": {
        "tree": [
          {
            "id": "root",
            "children": [
              {
                "id": "a",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "id from tree follow ^children",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`follow` takes a relation",
            "^"
          ]
        }
      }
    },
    {
      "name": "follow distinct does not take an outer reference",
      "roots": {
        "tree": [
          {
            "id": "root",
            "children": [
              {
                "id": "a",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "id from tree follow distinct ^children",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`follow` takes a relation",
            "^"
          ]
        }
      }
    },
    {
      "name": "stray closing parenthesis after the query",
      "query": "name from people )",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected ')'",
            "after the query"
          ]
        }
      }
    },
    {
      "name": "stray colon after the query",
      "query": "name from people :",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected ':'",
            "after the query"
          ]
        }
      }
    },
    {
      "name": "stray closing parenthesis inside a block",
      "query": "people exists { name from jobs ) }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected ')'",
            "'}'"
          ]
        }
      }
    },
    {
      "name": "a literal is not a receiver",
      "query": "true exists { }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`true` is a literal"
          ]
        }
      }
    },
    {
      "name": "a literal is not a follow relation",
      "query": "id from tree follow null",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`null` is a literal"
          ]
        }
      }
    },
    {
      "name": "dangling dot in a receiver",
      "query": "name, x: a. from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "after '.'"
          ]
        }
      }
    },
    {
      "name": "a comma after a where-first predicate",
      "tags": [
        "sugar",
        "where-first"
      ],
      "query": "people count { age >= 18, name }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "where age >= 18"
          ]
        }
      }
    },
    {
      "name": "a top-level leading predicate is never implicit where",
      "tags": [
        "sugar",
        "top-level"
      ],
      "query": "age > 15 from people",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "needs an alias",
            "never implicit"
          ]
        }
      }
    },
    {
      "name": "a negative bracket index",
      "tags": [
        "sugar",
        "brackets"
      ],
      "query": "j: jobs[-1] from people",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "negative indices are not supported"
          ]
        }
      }
    },
    {
      "name": "is does not chain",
      "tags": [
        "sugar",
        "is"
      ],
      "query": "from r where a is b is c",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "comparisons do not chain"
          ]
        }
      }
    },
    {
      "name": "a select alias used before its definition",
      "tags": [
        "sugar",
        "aliases"
      ],
      "query": "a: b, b: 1 from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "to its left"
          ]
        }
      }
    },
    {
      "name": "a select alias cycle",
      "tags": [
        "sugar",
        "aliases"
      ],
      "query": "a: b, b: a from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "select aliases form a cycle"
          ]
        }
      }
    },
    {
      "name": "a bare bracket lookup in where",
      "tags": [
        "sugar",
        "brackets"
      ],
      "query": "from people where jobs[pay > 2]",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "select-position lookup"
          ]
        }
      }
    },
    {
      "name": "a literal bracket receiver",
      "tags": [
        "sugar",
        "brackets"
      ],
      "query": "v: null[0] from r",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`null` is a literal"
          ]
        }
      }
    }
  ]
}
