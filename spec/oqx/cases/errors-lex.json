{
  "suite": "errors-lex",
  "cases": [
    {
      "name": "square bracket",
      "query": "from r where a[0] == 1",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "single equals",
      "query": "from r where a = 1",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "single ampersand",
      "query": "from r where a & b",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "single pipe",
      "query": "from r where a | b",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "at sign",
      "query": "from r where @a",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "hash is not a comment",
      "query": "from r # comment",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "semicolon",
      "query": "from r;",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unexpected character"
          ]
        }
      }
    },
    {
      "name": "unterminated double-quoted string",
      "query": "from r where a == \"abc",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unterminated string"
          ]
        }
      }
    },
    {
      "name": "unterminated single-quoted string",
      "query": "from r where a == 'abc",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unterminated string"
          ]
        }
      }
    },
    {
      "name": "escape at the end of input is unterminated",
      "query": "from r where a == \"abc\\",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "unterminated string"
          ]
        }
      }
    },
    {
      "name": "exponent without digits",
      "query": "x: 1e from r",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "exponent with a sign but no digits",
      "query": "x: 1e+ from r",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "uppercase exponent without digits",
      "query": "from r where a > 2E",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "trailing decimal point",
      "query": "x: 1. from r",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "decimal point before a name",
      "query": "x: 1.foo from r",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "leading-dot numeral",
      "query": "from r where a > .5",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    },
    {
      "name": "a digit after a dot is not index access",
      "query": "x: xs.0 from r",
      "expect": {
        "error": {
          "stage": "lex",
          "includes": [
            "malformed number"
          ]
        }
      }
    }
  ]
}
