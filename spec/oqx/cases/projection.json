    {
      "name": "logical operators yield an operand in value position",
      "notes": "`&&` yields its left operand when that is falsy, else its right; `||` yields its left when truthy, else its right. `f` is absent and drops out.",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "a: 0 || 5, b: \"\" || \"d\", c: 1 && 2, d: 0 && 2, e: nope || \"z\", f: 1 && nope from r",
      "expect": {
        "result": [
          {
            "a": 5,
            "b": "d",
            "c": 2,
            "d": 0,
            "e": "z"
          }
        ]
      }
    }
