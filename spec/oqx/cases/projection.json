    {
      "name": "absent property is dropped from the record",
      "notes": "`budget` is not a property of an order; the projected record has no `budget` key after canonicalization.",
      "roots": {
        "accounts": [
          {
            "owner": "x",
            "budget": 100,
            "orders": [
              {
                "amount": 50
              },
              {
                "amount": 150
              }
            ]
          },
          {
            "owner": "y",
            "budget": 200,
            "orders": [
              {
                "amount": 250
              }
            ]
          }
        ]
      },
      "query": "owner, b: orders collect { budget } from accounts where owner == \"y\"",
      "expect": {
        "result": [
          {
            "owner": "y",
            "b": [
              {}
            ]
          }
        ]
      }
    },
    {
      "name": "deep navigation through absent is absent",
      "roots": {
        "r": [
          {},
