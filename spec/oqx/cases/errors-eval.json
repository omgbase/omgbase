{
  "suite": "errors-eval",
  "cases": [
    {
      "name": "unknown function",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "from r where foo(1)",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "unknown function"
          ]
        }
      }
    },
    {
      "name": "unknown method",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "from r where a.foo()",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "unknown method"
          ]
        }
      }
    },
    {
      "name": "single with several rows at the top level",
      "roots": {
        "xs": [
          1,
          2
        ]
      },
      "query": "xs single { }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "single { … } matched 2 rows"
          ]
        }
      }
    },
    {
      "name": "single with several rows in a projection",
      "roots": {
        "r": [
          {
            "xs": [
              1,
              2
            ]
          }
        ]
      },
      "query": "n: xs single { $it values } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "single { … }",
            "matched 2 rows"
          ]
        }
      }
    },
    {
      "name": "limit fraction",
      "roots": {
        "xs": [
          1
        ]
      },
      "query": "from xs limit 1.5",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "limit must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "offset fraction",
      "roots": {
        "xs": [
          1
        ]
      },
      "query": "from xs offset 0.5",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "offset must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "limit from an absent outer field",
      "roots": {
        "r": [
          {
            "xs": [
              1
            ]
          }
        ]
      },
      "query": "n: xs collect { limit ^k } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "limit must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "offset from a string outer field",
      "roots": {
        "r": [
          {
            "k": "1",
            "xs": [
              1
            ]
          }
        ]
      },
      "query": "n: xs collect { offset ^k } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "offset must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "offset from a negative outer field",
      "roots": {
        "r": [
          {
            "k": -1,
            "xs": [
              1
            ]
          }
        ]
      },
      "query": "n: xs collect { offset ^k } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "offset must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "follow in a where op",
      "roots": {
        "tree": [
          {
            "id": "root",
            "label": "Root",
            "children": [
              {
                "id": "a",
                "label": "A",
                "children": [
                  {
                    "id": "a1",
                    "label": "A1",
                    "children": []
                  }
                ]
              },
              {
                "id": "b",
                "label": "B",
                "children": []
              }
            ]
          }
        ]
      },
      "query": "from tree where children exists { follow children }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "`follow` is only valid on a select-position collect"
          ]
        }
      }
    },
    {
      "name": "errors are raised even when the bound is never reached",
      "notes": "A block's bound is evaluated before its rows are read.",
      "roots": {
        "r": [
          {
            "xs": []
          }
        ]
      },
      "query": "n: xs collect { limit ^k } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "limit must be a non-negative integer"
          ]
        }
      }
    },
    {
      "name": "single reports the true row count at the top level",
      "notes": "`single` materializes every row before reducing, so the count is exact, not \"at least two\".",
      "roots": {
        "xs": [
          1,
          2,
          3
        ]
      },
      "query": "xs single { }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "single { … } matched 3 rows"
          ]
        }
      }
    },
    {
      "name": "single reports the true row count in a projection",
      "roots": {
        "r": [
          {
            "xs": [
              1,
              2,
              3
            ]
          }
        ]
      },
      "query": "n: xs single { $it values } from r",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "single { … }",
            "matched 3 rows"
          ]
        }
      }
    },
    {
      "name": "single reports the bounded row count",
      "roots": {
        "xs": [
          1,
          2,
          3,
          4
        ]
      },
      "query": "xs single { limit 2 }",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "matched 2 rows"
          ]
        }
      }
    },
    {
      "name": "a method named like an inherited property is unknown",
      "notes": "Builtin lookup is by own name only; host prototype members are not methods.",
      "roots": {
        "r": [
          {
            "a": 1
          }
        ]
      },
      "query": "from r where a.constructor()",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "unknown method"
          ]
        }
      }
    },
    {
      "name": "a function named like an inherited property is unknown",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "from r where constructor(1)",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "unknown function"
          ]
        }
      }
    },
    {
      "name": "a required value that is absent",
      "tags": [
        "sugar",
        "required"
      ],
      "roots": {
        "people": [
          {
            "id": 7,
            "name": "Bob"
          }
        ]
      },
      "query": "title! from people",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "`title!` is absent",
            "on 7"
          ]
        }
      }
    },
    {
      "name": "a required value that is absent on an id-less row",
      "tags": [
        "sugar",
        "required"
      ],
      "roots": {
        "q": [
          {
            "a": {}
          }
        ]
      },
      "query": "v: a.b! from q",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "`a.b!` is absent"
          ]
        }
      }
    },
    {
      "name": "a required single with many matches",
      "tags": [
        "sugar",
        "brackets",
        "required"
      ],
      "roots": {
        "q": [
          {
            "xs": [
              {
                "n": 1
              },
              {
                "n": 2
              }
            ]
          }
        ]
      },
      "query": "j: xs[n > 0]! from q",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "single",
            "matched 2 rows"
          ]
        }
      }
    },
    {
      "name": "a required single with no match",
      "tags": [
        "sugar",
        "brackets",
        "required"
      ],
      "roots": {
        "q": [
          {
            "id": "q1",
            "xs": [
              {
                "n": 1
              }
            ]
          }
        ]
      },
      "query": "j: xs[n > 5]! from q",
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "`xs single { where n > 5 }!` is absent",
            "on \"q1\""
          ]
        }
      }
    },
    {
      "name": "a bracket index binding must be a non-negative integer",
      "tags": [
        "sugar",
        "brackets"
      ],
      "roots": {
        "q": [
          {
            "xs": [
              1,
              2
            ]
          }
        ]
      },
      "template": {
        "strings": [
          "j: xs[",
          "] from q"
        ],
        "values": [
          1.5
        ]
      },
      "expect": {
        "error": {
          "stage": "eval",
          "includes": [
            "offset must be a non-negative integer"
          ]
        }
      }
    }
  ]
}
