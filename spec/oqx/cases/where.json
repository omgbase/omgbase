        ]
      },
      "query": "a values from xs where !jobs count { } > 1",
      "expect": {
        "result": [
          1
        ]
      }
    },
    {
      "name": "parenthesized arithmetic is a scalar leaf",
      "tags": [
        "parentheses"
      ],
      "roots": {
        "xs": [
          {
            "a": 1
          },
          {
            "a": 2
          }
        ]
      },
      "query": "a values from xs where (a + 1) > 2",
