    {
      "name": "a grouped predicate cannot be compared",
      "notes": "In `where`, parentheses group predicates, not values. Compare a logical expression through a select alias instead.",
      "query": "r exists { where (a || b) == 5 }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "unexpected '=='"
          ]
        }
      }
    },
    {
      "name": "bare predicate in a block wants where",
      "query": "people exists { age > 50 }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "write `where",
            "never implicit"
          ]
        }
      }
    },
    {
      "name": "bare negation in a block wants where",
      "query": "people exists { !active }",
      "expect": {
