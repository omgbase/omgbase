    {
      "name": "truthiness: falsy values",
      "notes": "Absent, false, 0, and the empty string are falsy; everything else — including an empty array or object — is truthy.",
      "roots": {
        "xs": [
          0,
          "",
          null,
          false,
          [],
          {},
          1,
          "a"
        ]
      },
      "query": "$value values from xs where $value",
      "expect": {
        "result": [
          [],
          {},
          1,
          "a"
        ]
      }
