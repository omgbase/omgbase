        "consumers"
      ],
      "notes": "A consumer test including its `<op> N` comparison is one operand of `!`.",
      "roots": {
        "xs": [
          {
            "a": 1,
            "jobs": []
          },
          {
            "a": 2,
            "jobs": [
              1,
              2
            ]
