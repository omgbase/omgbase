    {
      "name": "not binds tighter than comparison",
      "tags": [
        "not",
        "precedence"
      ],
      "notes": "`!` is a prefix unary operator in every position: `!a == b` is `(!a) == b`, never `!(a == b)`. Rows p and q distinguish the two readings.",
      "roots": {
        "xs": [
          {
            "tag": "p",
            "a": 0,
            "b": false
          },
          {
            "tag": "q",
            "a": 1,
            "b": true
          },
          {
            "tag": "r",
            "a": false,
            "b": true
          },
          {
            "tag": "s",
            "a": 1,
            "b": 1
          }
        ]
      },
      "query": "tag values from xs where !a == b",
      "expect": {
        "result": [
          "r"
        ]
      }
    },
    {
      "name": "not over a parenthesized comparison",
      "tags": [
        "not",
        "precedence"
      ],
      "roots": {
        "xs": [
          {
            "tag": "p",
            "a": 0,
            "b": false
          },
          {
            "tag": "q",
            "a": 1,
            "b": true
          },
          {
            "tag": "r",
            "a": false,
            "b": true
          },
          {
            "tag": "s",
            "a": 1,
            "b": 1
          }
        ]
      },
      "query": "tag values from xs where !(a == b)",
      "expect": {
        "result": [
          "p",
          "q",
          "r"
        ]
      }
    },
    {
      "name": "not over a group followed by a comparison applies to the group's value",
      "tags": [
        "not",
        "precedence"
      ],
      "notes": "`!(a) == false` is `(!a) == false`; the old where-only reading `!(a == false)` would keep both rows.",
      "roots": {
        "xs": [
          {
            "tag": "p",
            "a": 0
          },
          {
            "tag": "q",
            "a": 1
          }
        ]
      },
      "query": "tag values from xs where !(a) == false",
      "expect": {
        "result": [
          "q"
        ]
      }
    },
