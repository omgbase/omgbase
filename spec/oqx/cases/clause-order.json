    {
      "name": "select after from",
      "query": "from people select name",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`select` must come before `from`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "select after where",
      "query": "from people where age > 50 select name",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`select` must come before `where`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "where after order by",
      "query": "name from people order by age where age > 50",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`where` must come before `order by`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "where after follow",
      "query": "name from people follow jobs where age > 50",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`where` must come before `follow`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "order by after limit",
      "query": "name from people limit 1 order by age",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`order by` must come before `limit`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "limit after offset",
      "query": "name from people offset 1 limit 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`limit` must come before `offset`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
    {
      "name": "block select after where",
      "query": "people count { where age > 50 select name }",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "`select` must come before `where`",
            "OQX clause order is select, from, where, follow, order by, limit, offset"
          ]
        }
      }
    },
