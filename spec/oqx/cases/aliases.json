    {
      "name": "alias chain resolves through",
      "notes": "`s` inlines to `senior`'s expression in `where`; as a projected value `s` is the row field `senior`, which is absent.",
      "roots": {
        "people": [
          {
            "name": "Bob",
            "id": 124,
            "title": "Engineer",
            "active": true,
            "age": 41,
            "jobs": [
