                "start_date": "1999/01/01",
                "end_date": "2005/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2010/06/01",
                "end_date": "2015/01/01"
              }
            ]
          },
          {
            "name": "Carol",
            "id": 55,
            "title": "Analyst",
            "active": false,
            "age": 29,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "2020/01/01"
              }
            ]
          }
        ]
      },
      "query": "select senior: age > 50, s: senior from people where s",
      "expect": {
        "result": [
          {
            "senior": true
          }
        ]
      }
    },
    {
      "name": "unaliased dotted item is an alias for its key",
      "roots": {
        "data": [
          {
            "meta": {
              "slug": "a"
            }
          },
          {
            "meta": {
              "slug": "b"
            }
          }
        ]
      },
      "query": "select meta.slug from data where slug == \"b\"",
      "expect": {
        "result": [
          {
            "slug": "b"
          }
        ]
      }
