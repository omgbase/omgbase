    {
      "name": "collect alias inside an expression is an error",
      "query": "select n: jobs collect { employer } from people where n.size() > 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "alias 'n' is a collect"
          ]
        }
      }
