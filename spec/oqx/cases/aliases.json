    {
      "name": "two-alias cycle",
      "query": "select a: b, b: a from people where a",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "select aliases form a cycle: a → b → a"
          ]
        }
      }
    },
    {
      "name": "three-alias cycle",
      "query": "select a: b + 1, b: c, c: a from people where c > 1",
      "expect": {
        "error": {
          "stage": "parse",
          "includes": [
            "cycle: c → a → b → c"
          ]
        }
      }
    },
    {
      "name": "unreferenced swap is fine",
      "roots": {
        "xs": [
          {
            "a": 1,
            "b": 2
          }
        ]
      },
      "query": "select a: b, b: a from xs",
      "expect": {
        "result": [
          {
            "a": 2,
            "b": 1
          }
        ]
      }
