        "result": [
          {
            "x": "ab"
          }
        ]
      }
    },
    {
      "name": "string plus number concatenates",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"a\" + 1 from r",
      "expect": {
        "result": [
          {
            "x": "a1"
          }
        ]
      }
    },
    {
      "name": "number plus string concatenates",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 1 + \"a\" from r",
      "expect": {
        "result": [
          {
            "x": "1a"
          }
        ]
      }
    },
    {
      "name": "integer-valued doubles print without a fraction",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n\" + 2.0 from r",
      "expect": {
        "result": [
          {
            "x": "n2"
          }
        ]
      }
    },
    {
      "name": "fractions print with a point",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n\" + 2.5 from r",
      "expect": {
        "result": [
          {
            "x": "n2.5"
          }
        ]
      }
    },
    {
      "name": "negative numbers print with a sign",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n\" + -3 from r",
      "expect": {
        "result": [
          {
            "x": "n-3"
          }
        ]
      }
    },
    {
      "name": "negative zero prints as zero",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n\" + -0 from r",
      "expect": {
        "result": [
          {
            "x": "n0"
          }
        ]
      }
    },
    {
      "name": "booleans print as words",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"is:\" + true from r",
      "expect": {
        "result": [
          {
            "x": "is:true"
          }
        ]
      }
    },
    {
      "name": "concatenation is left associative",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n:\" + 1 + 2 from r",
      "expect": {
        "result": [
          {
            "x": "n:12"
          }
        ]
      }
    },
    {
      "name": "addition inside concatenation needs parentheses",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"n:\" + (1 + 2) from r",
      "expect": {
        "result": [
          {
            "x": "n:3"
          }
        ]
      }
    },
