{
  "suite": "arithmetic",
  "cases": [
    {
      "name": "addition",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 1 + 2 from r",
      "expect": {
        "result": [
          {
            "x": 3
          }
        ]
      }
    },
    {
      "name": "subtraction",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 5 - 7 from r",
      "expect": {
        "result": [
          {
            "x": -2
          }
        ]
      }
    },
    {
      "name": "multiplication",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 3 * 4 from r",
      "expect": {
        "result": [
          {
            "x": 12
          }
        ]
      }
    },
    {
      "name": "division",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 7 / 2 from r",
      "expect": {
        "result": [
          {
            "x": 3.5
          }
        ]
      }
    },
    {
      "name": "division is exact for integers",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 8 / 2 from r",
      "expect": {
        "result": [
          {
            "x": 4
          }
        ]
      }
    },
    {
      "name": "remainder",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 7 % 3 from r",
      "expect": {
        "result": [
          {
            "x": 1
          }
        ]
      }
    },
    {
      "name": "remainder takes the dividend's sign",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: -7 % 3 from r",
      "expect": {
        "result": [
          {
            "x": -1
          }
        ]
      }
    },
    {
      "name": "remainder of a fraction",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 5.5 % 2 from r",
      "expect": {
        "result": [
          {
            "x": 1.5
          }
        ]
      }
    },
    {
      "name": "multiplication before addition",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 1 + 2 * 3 from r",
      "expect": {
        "result": [
          {
            "x": 7
          }
        ]
      }
    },
    {
      "name": "parentheses group",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: (1 + 2) * 3 from r",
      "expect": {
        "result": [
          {
            "x": 9
          }
        ]
      }
    },
    {
      "name": "left associativity of subtraction",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 10 - 2 - 3 from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "left associativity of multiplicative operators",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 2 * 3 % 4 from r",
      "expect": {
        "result": [
          {
            "x": 2
          }
        ]
      }
    },
    {
      "name": "division then multiplication",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 8 / 2 * 2 from r",
      "expect": {
        "result": [
          {
            "x": 8
          }
        ]
      }
    },
    {
      "name": "unary minus",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: -5 from r",
      "expect": {
        "result": [
          {
            "x": -5
          }
        ]
      }
    },
    {
      "name": "unary minus on a field",
      "roots": {
        "r": [
          {
            "age": 41
          }
        ]
      },
      "query": "x: -age from r",
      "expect": {
        "result": [
          {
            "x": -41
          }
        ]
      }
    },
    {
      "name": "unary minus binds tighter than multiplication",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: -2 * 3 from r",
      "expect": {
        "result": [
          {
            "x": -6
          }
        ]
      }
    },
    {
      "name": "double negation",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: --5 from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "doubles",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 0.1 + 0.2 from r",
      "expect": {
        "result": [
          {
            "x": 0.30000000000000004
          }
        ]
      }
    },
    {
      "name": "integer-valued result of a fractional product",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 2.5 * 2 from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "exponent literal",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 1e3 from r",
      "expect": {
        "result": [
          {
            "x": 1000
          }
        ]
      }
    },
    {
      "name": "negative exponent literal",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 25e-1 from r",
      "expect": {
        "result": [
          {
            "x": 2.5
          }
        ]
      }
    },
    {
      "name": "fields",
      "roots": {
        "r": [
          {
            "age": 41
          }
        ]
      },
      "query": "x: age * 2 from r",
      "expect": {
        "result": [
          {
            "x": 82
          }
        ]
