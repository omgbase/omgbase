    {
      "name": "startsWith on a non-string is false",
      "roots": {
        "r": [
          {
            "n": 42
          }
        ]
      },
      "query": "r exists { where n.startsWith(\"4\") }",
      "expect": {
        "result": false
      }
    },
    {
      "name": "endsWith on absent is false",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where nope.endsWith(\"\") }",
      "expect": {
        "result": false
      }
