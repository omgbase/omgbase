{
  "suite": "strings",
  "cases": [
    {
      "name": "lower",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"AbC\".lower() from r",
      "expect": {
        "result": [
          {
            "x": "abc"
          }
        ]
      }
    },
    {
      "name": "upper",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"AbC\".upper() from r",
      "expect": {
        "result": [
          {
            "x": "ABC"
          }
        ]
      }
    },
    {
      "name": "lower on a field in where",
      "roots": {
        "people": [
          {
            "name": "Bob",
            "id": 124,
            "title": "Engineer",
            "active": true,
            "age": 41,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "1984/05/01",
                "end_date": "1990/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2001/03/01"
              }
            ]
          },
          {
            "name": "Alice",
            "id": 7,
            "title": "Director",
            "active": true,
            "age": 52,
            "jobs": [
              {
                "employer": "Initech",
                "start_date": "1999/01/01",
                "end_date": "2005/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2010/06/01",
                "end_date": "2015/01/01"
              }
            ]
          },
          {
            "name": "Carol",
            "id": 55,
            "title": "Analyst",
            "active": false,
            "age": 29,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "2020/01/01"
              }
            ]
          }
        ]
      },
      "query": "name values from people where title.lower() == \"director\"",
      "expect": {
        "result": [
          "Alice"
        ]
      }
    },
    {
      "name": "lower on a number is its text form",
      "roots": {
        "r": [
          {
            "n": 5
          }
        ]
      },
      "query": "x: n.lower() from r",
      "expect": {
        "result": [
          {
            "x": "5"
          }
        ]
      }
    },
    {
      "name": "upper on a boolean is its text form",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: true.upper() from r",
      "expect": {
        "result": [
          {
            "x": "TRUE"
          }
        ]
      }
    },
    {
      "name": "contains substring",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"hello\".contains(\"ell\") }",
      "expect": {
        "result": true
      }
    },
    {
      "name": "contains is case-sensitive",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"hello\".contains(\"ELL\") }",
      "expect": {
        "result": false
      }
    },
    {
      "name": "contains on an array uses strict equality",
      "roots": {
        "r": [
          {
            "xs": [
              1,
              2
            ]
          }
        ]
      },
      "query": "r exists { where xs.contains(2) && !xs.contains(\"2\") }",
      "expect": {
        "result": true
      }
    },
    {
      "name": "contains on a number is false",
      "roots": {
        "r": [
          {
            "n": 5
          }
        ]
      },
      "query": "r exists { where n.contains(1) }",
      "expect": {
        "result": false
      }
    },
    {
      "name": "contains on absent is false",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where nope.contains(\"a\") }",
      "expect": {
        "result": false
      }
    },
    {
      "name": "contains filters rows",
      "roots": {
        "people": [
          {
            "name": "Bob",
            "id": 124,
            "title": "Engineer",
            "active": true,
            "age": 41,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "1984/05/01",
                "end_date": "1990/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2001/03/01"
              }
            ]
          },
          {
            "name": "Alice",
            "id": 7,
            "title": "Director",
            "active": true,
            "age": 52,
            "jobs": [
              {
                "employer": "Initech",
                "start_date": "1999/01/01",
                "end_date": "2005/01/01"
              },
              {
                "employer": "Globocorp",
                "start_date": "2010/06/01",
                "end_date": "2015/01/01"
              }
            ]
          },
          {
            "name": "Carol",
            "id": 55,
            "title": "Analyst",
            "active": false,
            "age": 29,
            "jobs": [
              {
                "employer": "Globocorp",
                "start_date": "2020/01/01"
              }
            ]
          }
        ]
      },
      "query": "name values from people where jobs.size() > 0 && title.contains(\"ir\")",
      "expect": {
        "result": [
          "Alice"
        ]
      }
    },
