    {
      "name": "size of a string",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"hello\".size() from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "size of the empty string",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"\".size() from r",
      "expect": {
        "result": [
          {
            "x": 0
          }
        ]
      }
    },
    {
      "name": "size of an array",
      "roots": {
        "r": [
          {
            "xs": [
              1,
              2,
              3
            ]
          }
        ]
      },
      "query": "x: xs.size() from r",
      "expect": {
        "result": [
          {
            "x": 3
          }
        ]
      }
    },
    {
      "name": "size of an object counts keys",
      "roots": {
        "r": [
          {
            "o": {
              "a": 1,
              "b": 2
            }
          }
        ]
      },
      "query": "x: o.size() from r",
      "expect": {
        "result": [
          {
            "x": 2
          }
        ]
      }
    },
    {
      "name": "size of absent is zero",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: nope.size() from r",
      "expect": {
        "result": [
          {
            "x": 0
          }
        ]
      }
    },
    {
      "name": "size of a number is zero",
      "roots": {
        "r": [
          {
            "n": 5
          }
        ]
      },
      "query": "x: n.size() from r",
      "expect": {
        "result": [
          {
            "x": 0
          }
        ]
      }
    },
    {
      "name": "size in a predicate",
      "roots": {
        "players": [
          {
            "name": "Ann",
            "scores": [
              10,
              60,
              70
            ]
          },
          {
            "name": "Ben",
            "scores": [
              45
            ]
          },
          {
            "name": "Cid",
            "scores": []
          }
        ]
      },
      "query": "name values from players where scores.size() > 1",
      "expect": {
        "result": [
          "Ann"
        ]
      }
    },
    {
      "name": "double-quoted escapes",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"a\\nb\\t\\\"q\\\"\\\\\" from r",
      "expect": {
        "result": [
          {
            "x": "a\nb\t\"q\"\\"
          }
        ]
      }
    },
    {
      "name": "single-quoted string",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 'NYC' from r",
      "expect": {
        "result": [
          {
            "x": "NYC"
          }
        ]
      }
    },
    {
      "name": "single-quoted escape",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: 'it\\'s' from r",
      "expect": {
        "result": [
          {
            "x": "it's"
          }
        ]
      }
    },
    {
      "name": "quotes are interchangeable",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where 'a' == \"a\" }",
      "expect": {
        "result": true
      }
    },
    {
      "name": "unknown escape is the character itself",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"\\q\" from r",
      "expect": {
        "result": [
          {
            "x": "q"
          }
        ]
      }
    },
    {
      "name": "carriage return and nul escapes",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"a\\rb\\0c\".size() from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "unicode strings compare by code point",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where \"é\" == \"é\" && \"e\" < \"é\" }",
      "expect": {
        "result": true
      }
    },
    {
      "name": "size of a non-ASCII BMP string",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"héllo\".size() from r",
      "expect": {
        "result": [
          {
            "x": 5
          }
        ]
      }
    },
    {
      "name": "chained methods",
      "roots": {
        "r": [
          {
            "name": "Bob"
          }
        ]
      },
      "query": "x: name.lower().upper() from r",
      "expect": {
        "result": [
          {
            "x": "BOB"
          }
        ]
      }
    },
    {
      "name": "method on a navigation",
      "roots": {
        "r": [
          {
            "meta": {
              "slug": "a"
            }
          }
        ]
      },
      "query": "x: meta.slug.upper() from r",
      "expect": {
        "result": [
          {
            "x": "A"
          }
        ]
      }
    },
    {
      "name": "size counts code points",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"😀\".size() from r",
      "expect": {
        "result": [
          {
            "x": 1
          }
        ]
      }
    },
    {
      "name": "size counts code points in a mixed string",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "x: \"a😀b\".size() from r",
      "expect": {
        "result": [
          {
            "x": 3
          }
        ]
      }
    },
    {
      "name": "lower on absent is absent",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "nope.lower() values from r",
      "expect": {
        "result": [
          null
        ]
      }
    },
    {
      "name": "upper on null is absent",
      "roots": {
        "r": [
          {
            "n": null
          }
        ]
      },
      "query": "n.upper() values from r",
      "expect": {
        "result": [
          null
        ]
      }
    },
    {
      "name": "lower on absent equals null",
      "roots": {
        "r": [
          {}
        ]
      },
      "query": "r exists { where nope.lower() == null }",
      "expect": {
        "result": true
      }
    }
  ]
