{
  "suite": "collection-scoped",
  "cases": [
    {
      "name": "the collection heads the body",
      "tags": [
        "source",
        "follow",
        "order"
      ],
      "notes": "The 0.26 form: the source is the receiver of the whole-query block, every clause keeps its keyword and its position (the body's `select` reads the rows, `^modules` from a destination block is the named root, `^needs` the frontier row's field). The same query as a clause-form body (`select … from modules …`) is the next case; the two are one tree (the `ast` cases below).",
      "roots": {
        "modules": [
          {
            "id": "launch",
            "name": "Launch",
            "status": "open",
            "needs": [
              "infra",
              "auth"
            ]
          },
          {
            "id": "infra",
            "name": "Infra",
            "status": "done",
            "needs": [
              "net"
            ]
          },
          {
            "id": "auth",
            "name": "Auth",
            "status": "open",
            "needs": [
              "net"
            ]
          },
          {
            "id": "net",
            "name": "Net",
            "status": "done",
            "needs": []
          }
        ]
      },
      "query": "modules {\n  select id, name, status, depth: $depth\n  where id == \"launch\"\n  follow distinct ^modules {\n    where id in ^needs\n    depth 2\n  }\n  order by $depth, name\n}",
      "expect": {
        "result": [
          {
            "id": "launch",
            "name": "Launch",
            "status": "open",
            "depth": 1
          },
          {
            "id": "auth",
            "name": "Auth",
            "status": "open",
            "depth": 2
          },
          {
            "id": "infra",
            "name": "Infra",
            "status": "done",
            "depth": 2
          }
        ]
      }
    },
