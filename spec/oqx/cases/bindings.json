    {
      "name": "a bound collection as a nested receiver",
      "template": {
        "strings": [
          "name, siblings: ",
          " collect { name where parent == ^parent && name != ^name } from ",
          ""
        ],
        "values": [
          [
            {
              "name": "Ada",
              "parent": "Pat"
            },
            {
              "name": "Ben",
              "parent": "Pat"
            },
            {
              "name": "Cy",
              "parent": "Sam"
            }
          ],
          [
            {
              "name": "Ada",
              "parent": "Pat"
            },
            {
              "name": "Ben",
              "parent": "Pat"
            },
            {
              "name": "Cy",
              "parent": "Sam"
            }
          ]
        ]
      },
      "expect": {
        "result": [
          {
            "name": "Ada",
            "siblings": [
              {
                "name": "Ben"
              }
            ]
          },
          {
            "name": "Ben",
            "siblings": [
              {
                "name": "Ada"
              }
            ]
          },
          {
            "name": "Cy",
            "siblings": []
          }
        ]
      }
    },
