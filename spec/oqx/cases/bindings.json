{
  "suite": "bindings",
  "cases": [
    {
      "name": "collection in from and a string in a predicate",
      "template": {
        "strings": [
          "name, id, title from ",
          " where jobs exists { where employer == ",
          " && !end_date }"
        ],
        "values": [
          [
            {
              "name": "Bob",
              "id": 124,
              "title": "Engineer",
              "active": true,
              "age": 41,
              "jobs": [
                {
                  "employer": "Globocorp",
                  "start_date": "1984/05/01",
                  "end_date": "1990/01/01"
                },
                {
                  "employer": "Globocorp",
                  "start_date": "2001/03/01"
                }
              ]
            },
            {
              "name": "Alice",
              "id": 7,
              "title": "Director",
              "active": true,
              "age": 52,
              "jobs": [
                {
                  "employer": "Initech",
                  "start_date": "1999/01/01",
                  "end_date": "2005/01/01"
                },
                {
                  "employer": "Globocorp",
                  "start_date": "2010/06/01",
                  "end_date": "2015/01/01"
                }
              ]
            },
            {
              "name": "Carol",
              "id": 55,
              "title": "Analyst",
              "active": false,
              "age": 29,
              "jobs": [
                {
                  "employer": "Globocorp",
                  "start_date": "2020/01/01"
                }
              ]
            }
          ],
          "Globocorp"
        ]
      },
      "expect": {
        "result": [
          {
            "name": "Bob",
            "id": 124,
            "title": "Engineer"
          },
          {
            "name": "Carol",
            "id": 55,
            "title": "Analyst"
          }
        ]
      }
    },
