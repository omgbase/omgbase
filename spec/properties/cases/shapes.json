      "expect": {
        "rows": [
          {
            "prop_id": "p_918ed12fee37",
            "block_id": null,
            "source": "frontmatter",
            "key": "items",
            "card": "list",
            "ord": 0,
            "type": "json",
            "val_text": null,
            "val_num": null,
            "val_bool": null,
            "val_json": [
              {
                "a": 1
