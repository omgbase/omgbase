{
  "suite": "shapes",
  "cases": [
    {
      "name": "one-element-yaml-list-reads-as-array",
      "notes": "§5: a single card=list row is not a lone scalar row → array of one.",
      "source": "---\ntags: [a]\n---\n",
      "expect": {
        "rows": [
          {
            "prop_id": "p_09255ac07329",
            "block_id": null,
            "source": "frontmatter",
            "key": "tags",
            "card": "list",
            "ord": 0,
            "type": "string",
            "val_text": "a",
            "val_num": null,
            "val_bool": null,
            "val_json": null
          }
        ],
        "grouped": {
          "frontmatter": {
            "tags": [
              "a"
            ]
          },
          "inline": {},
          "computed": {}
        },
        "merged": {
          "tags": [
            "a"
          ]
        }
      }
    },
    {
      "name": "frontmatter-and-inline-same-key-merged-array-grouped-separate",
      "notes": "§5 / §8: two card=scalar rows from different sources; grouped shows each as a scalar, merged as [frontmatter, inline].",
      "source": "---\nowner: alice\n---\n\nowner:: bob\n",
      "expect": {
        "rows": [
          {
            "prop_id": "p_d643c0a58bce",
            "block_id": null,
            "source": "frontmatter",
            "key": "owner",
            "card": "scalar",
            "ord": 0,
            "type": "string",
            "val_text": "alice",
            "val_num": null,
            "val_bool": null,
            "val_json": null
          },
          {
            "prop_id": "p_3a9a401e663c",
            "block_id": "b_0",
            "source": "inline",
            "key": "owner",
            "card": "scalar",
            "ord": 0,
            "type": "string",
            "val_text": "bob",
            "val_num": null,
            "val_bool": null,
            "val_json": null
          }
        ],
        "grouped": {
          "frontmatter": {
            "owner": "alice"
          },
          "inline": {
            "owner": "bob"
          },
          "computed": {}
        },
        "merged": {
          "owner": [
            "alice",
            "bob"
          ]
        }
      }
    },
    {
