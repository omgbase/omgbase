{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": ["index.d.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
