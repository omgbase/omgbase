{
  "id": "frontmatter-edit",
  "prompt": "Mark the philosophers' stone note (/substances/philosophers-stone.md) as verified: set its frontmatter field `verified` to true. Change nothing else.",
  "checks": [
    {
      "kind": "query",
      "query": "docs { select verified where _path == \"/substances/philosophers-stone.md\" }",
      "hits": [
        {
          "verified": true
        }
      ]
    },
    {
      "kind": "read",
      "path": "/substances/philosophers-stone.md",
      "matches": [
        "^---\\n(?:[^\\n]*\\n)*?verified: true\\n(?:[^\\n]*\\n)*?---\\n"
      ],
      "not_matches": [
        "verified: false"
      ]
    }
  ],
  "solution": {
    "steps": [
      {
        "tool": "apply",
        "args": {
          "effects": [
            {
              "op": "set",
              "target": {
                "kind": "document",
                "_path": "/substances/philosophers-stone.md"
              },
              "field": "_frontmatter.verified",
              "value": true
            }
          ],
          "reason": "verified"
        }
      }
    ],
    "final_text": "Set verified: true on /substances/philosophers-stone.md."
  },
  "solution_fs": {
    "steps": [
      {
        "tool": "read_file",
        "args": {
          "path": "/substances/philosophers-stone.md"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/substances/philosophers-stone.md",
          "old_string": "verified: false\n",
          "new_string": "verified: true\n"
        }
      }
    ],
    "final_text": "Set verified: true on /substances/philosophers-stone.md."
  }
}
