{
  "id": "doc-move",
  "prompt": "Rename the Newton note: move /practitioners/newton.md to /practitioners/isaac-newton.md, and make sure every link in the repository that pointed at the old path now points at the new one.",
  "checks": [
    {
      "kind": "query",
      "query": "from docs where _path == \"/practitioners/isaac-newton.md\"",
      "hits": [
        {
          "_path": "/practitioners/isaac-newton.md"
        }
      ]
    },
    {
      "kind": "query",
      "query": "from docs where _path == \"/practitioners/newton.md\"",
      "hits": []
    },
    {
      "kind": "read",
      "path": "/index.md",
      "matches": [
        "\\(/practitioners/isaac-newton\\.md\\)"
      ],
      "not_matches": [
        "\\(/practitioners/newton\\.md\\)"
      ]
    },
    {
      "kind": "read",
      "path": "/texts/emerald-tablet.md",
      "matches": [
        "\\(/practitioners/isaac-newton\\.md\\)"
      ],
      "not_matches": [
        "\\(/practitioners/newton\\.md\\)"
      ]
    }
  ],
  "solution": {
    "steps": [
      {
        "tool": "apply",
        "args": {
          "effects": [
            {
              "op": "move",
              "target": {
                "kind": "document",
                "_path": "/practitioners/newton.md"
              },
              "to": "practitioners/isaac-newton.md"
            }
          ]
        }
      }
    ],
    "final_text": "Moved the note to /practitioners/isaac-newton.md; the two inbound links were retargeted."
  },
  "solution_fs": {
    "steps": [
      {
        "tool": "grep",
        "args": {
          "pattern": "practitioners/newton\\.md"
        }
      },
      {
        "tool": "move_file",
        "args": {
          "from": "/practitioners/newton.md",
          "to": "/practitioners/isaac-newton.md"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/index.md",
          "old_string": "[Isaac Newton](/practitioners/newton.md)",
          "new_string": "[Isaac Newton](/practitioners/isaac-newton.md)"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/texts/emerald-tablet.md",
          "old_string": "[Newton](/practitioners/newton.md)",
          "new_string": "[Newton](/practitioners/isaac-newton.md)"
        }
      }
    ],
    "final_text": "Moved the note to /practitioners/isaac-newton.md and rewrote the two inbound links (index.md, texts/emerald-tablet.md)."
  },
  "notes": "On bare files a move is `move_file` plus a grep for the old path and one edit per linking file — the two inbound links have to be rewritten by hand; omgbase's `move` retargets them itself. The sweep sees the move as a deletion plus an insertion."
}
