{
  "id": "bulk-check-off",
  "prompt": "All three open tasks in /texts/mutus-liber.md have been done. Check them all off.",
  "checks": [
    {
      "kind": "query",
      "query": "nodes { select checked where _kind == \"md:task\" and _path == \"/texts/mutus-liber.md\" }",
      "hits": [
        {
          "checked": true
        },
        {
          "checked": true
        },
        {
          "checked": true
        }
      ]
    },
    {
      "kind": "read",
      "path": "/texts/mutus-liber.md",
      "not_matches": [
        "- \\[ \\]"
      ],
      "matches": [
        "- \\[x\\] Obtain a facsimile with plate numbering\\n- \\[x\\] Compare the 1677 and 1702 plate sequences\\n- \\[x\\] Decide whether the dew operation is literal"
      ]
    }
  ],
  "solution": {
    "steps": [
      {
        "tool": "apply",
        "args": {
          "select": "blocks { _type == \"task\" and not checked and _path == \"/texts/mutus-liber.md\" }",
          "effects": [
            {
              "op": "set",
              "field": "_attrs.checked",
              "value": true
            }
          ],
          "expect": {
            "max": 10
          }
        }
      }
    ],
    "final_text": "Checked off the three tasks in /texts/mutus-liber.md."
  },
  "solution_fs": {
    "steps": [
      {
        "tool": "read_file",
        "args": {
          "path": "/texts/mutus-liber.md"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/texts/mutus-liber.md",
          "old_string": "- [ ] Obtain a facsimile with plate numbering",
          "new_string": "- [x] Obtain a facsimile with plate numbering"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/texts/mutus-liber.md",
          "old_string": "- [ ] Compare the 1677 and 1702 plate sequences",
          "new_string": "- [x] Compare the 1677 and 1702 plate sequences"
        }
      },
      {
        "tool": "edit_file",
        "args": {
          "path": "/texts/mutus-liber.md",
          "old_string": "- [ ] Decide whether the dew operation is literal",
          "new_string": "- [x] Decide whether the dew operation is literal"
        }
      }
    ],
    "final_text": "Checked off the three tasks in /texts/mutus-liber.md."
  }
}
