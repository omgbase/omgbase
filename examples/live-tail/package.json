{
  "name": "live-tail",
  "version": "0.0.0",
  "private": true,
  "description": "omgbase live-tail demo: the most recently updated documents with the unified diff of their latest change, then every commit as it lands — `changes_since` polled with a cursor, each digest prepended with its revisions' diffs (Lit 3 + signals, Shoelace, MCP over Streamable HTTP through webdevproxy)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:workspace": "node scripts/dev-workspace.mjs",
    "dev:mcp": "node scripts/dev.mjs --proxy-only",
    "logout": "webdevproxy --logout",
    "dev:vite": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "webdevproxy": "workspace:^"
  }
}
