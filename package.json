{
  "name": "omgbase-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Open Markdown Graph Base — workspace root",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.0",
  "scripts": {
    "build": "pnpm --filter @omgbase/oqx build && tsc -b && node packages/cli/scripts/build-info.mjs",
    "typecheck": "pnpm --filter @omgbase/oqx build && tsc -b",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "interop": "cargo build -p omgbase && pnpm build && pnpm --filter @omgbase/core exec vitest run corpus/surface/interop.test.ts && cargo test -p omgbase --test interop",
    "release": "node scripts/release.mjs",
    "publish:npm": "node scripts/release.mjs publish --npm-only",
    "rlink": "pnpm -r build && for pkg in packages/*/; do grep -q '\"bin\"' \"$pkg/package.json\" && (cd \"$pkg\" && pnpm add -g .); done"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "node-gyp": "^11.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
